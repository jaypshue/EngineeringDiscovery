@namespace EngineeringDiscovery.Web.Components.Dashboard.Cards

<div class="card action-card">
    <h4>@Title</h4>
    <div class="muted">@ChildContent</div>
</div>

@code {
    [Parameter]
    public string Title { get; set; } = "Action";

    [Parameter]
    public RenderFragment? ChildContent { get; set; }
}
