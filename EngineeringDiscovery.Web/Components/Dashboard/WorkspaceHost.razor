@using EngineeringDiscovery.Core.Domain.Models
@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Core.Domain
@using EngineeringDiscovery.Web.Components.Workspaces
@namespace EngineeringDiscovery.Web.Components.Dashboard

<section class="workspace-host">
    <h2>@Title</h2>

    <section class="discovery">
        <h4>Investigation Dashboard</h4>
        <p><strong>Investigation Target:</strong> @CurrentTarget</p>
        <p><strong>Discovery Status:</strong> @DiscoveryStatus</p>
        <p><strong>Investigation Status:</strong> @(SampleInvestigation?.Status.ToString() ?? "n/a")</p>
        <input @bind="CurrentTarget" placeholder="Investigation target (optional)" />
        <button class="btn" @onclick="StartDiscovery" disabled="@(DiscoveryStatus != "Idle")">Start Discovery</button>
    </section>

    <div class="workspace-placeholder">
        @RenderWorkspace()
    </div>
</section>

@code {
    [Parameter]
    public EngineeringRole Role { get; set; }

    private string Title => Role switch
    {
        EngineeringRole.Architect => "Architect Workspace",
        EngineeringRole.Planner => "Planner Workspace",
        EngineeringRole.Developer => "Developer Workspace",
        EngineeringRole.Verifier => "Verifier Workspace",
        EngineeringRole.Reviewer => "Reviewer Workspace",
        _ => "Workspace"
    };

    // WorkspaceHost now receives a shared Investigation from a Discovery Engine and passes it into workspaces.
    // Prefer SolutionDiscoveryEngine when available so the UI reflects the current solution under development.
    private readonly EngineeringDiscovery.Web.Services.IDiscoveryEngine discoveryEngine = new EngineeringDiscovery.Web.Services.SolutionDiscoveryEngine();

    private string CurrentTarget { get; set; } = string.Empty;

    private string DiscoveryStatus { get; set; } = "Idle";

    private EngineeringDiscovery.Core.Domain.Investigation.Investigation? SampleInvestigation { get; set; }

    private void StartDiscovery()
    {
        DiscoveryStatus = "Running";
        // Execute discovery synchronously and store the resulting investigation
        SampleInvestigation = discoveryEngine.CreateInvestigation(string.IsNullOrWhiteSpace(CurrentTarget) ? null : CurrentTarget);

        // Starting discovery should also transition the Investigation to Started automatically
        try
        {
            SampleInvestigation?.Start();
        }
        catch (InvalidOperationException)
        {
            // Ignore: investigation may already be started by the engine
        }

        DiscoveryStatus = "Complete";
    }

    private RenderFragment RenderWorkspace()
    {
        // Do not render any workspace until an Investigation has been produced by the Discovery Engine.
        if (SampleInvestigation is null)
        {
            // At startup the Investigation Dashboard (above) contains the single Start Discovery action.
            // The workspace area stays empty until discovery completes.
            return (__builder) => { };
        }

        // After discovery completes, render the appropriate workspace and always pass a non-null Investigation.
        return Role switch
        {
            EngineeringRole.Architect => (__builder) => { __builder.OpenComponent(0, typeof(ArchitectWorkspace)); __builder.AddAttribute(1, "Investigation", (object)SampleInvestigation!); __builder.CloseComponent(); },
            EngineeringRole.Planner => (__builder) => { __builder.OpenComponent(0, typeof(PlannerWorkspace)); __builder.AddAttribute(1, "Investigation", (object)SampleInvestigation!); __builder.CloseComponent(); },
            EngineeringRole.Developer => (__builder) => { __builder.OpenComponent(0, typeof(DeveloperWorkspace)); __builder.AddAttribute(1, "Investigation", (object)SampleInvestigation!); __builder.CloseComponent(); },
            EngineeringRole.Verifier => (__builder) => { __builder.OpenComponent(0, typeof(VerifierWorkspace)); __builder.AddAttribute(1, "Investigation", (object)SampleInvestigation!); __builder.CloseComponent(); },
            EngineeringRole.Reviewer => (__builder) => { __builder.OpenComponent(0, typeof(ReviewerWorkspace)); __builder.AddAttribute(1, "Investigation", (object)SampleInvestigation!); __builder.CloseComponent(); },
            _ => (__builder) => { __builder.AddContent(0, "Workspace content."); }
        };
    }
}
