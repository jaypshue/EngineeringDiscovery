@using Microsoft.AspNetCore.Components
@using Microsoft.AspNetCore.Components.Web
@using EngineeringDiscovery.Core.Domain.Models

@namespace EngineeringDiscovery.Web.Components.Dashboard

<nav class="role-nav" aria-label="Role navigation">
    <div class="role-nav__header">Roles</div>

    <ul class="role-nav__list">
        @foreach (var role in ItemsResolved)
        {
            var isActive = role == ActiveRole;
            <li class="role-nav__item @(isActive ? "active" : string.Empty)"
                role="button"
                tabindex="0"
                aria-current="@(isActive ? "page" : null)"
                @onclick="() => SelectRole(role)"
                @onkeydown="(e) => OnKeyDown(e, role)">
                <span class="role-nav__name">@GetRoleName(role)</span>
            </li>
        }
    </ul>

    @if (ChildContent is not null)
    {
        <div class="role-nav__extra">
            @ChildContent
        </div>
    }
</nav>

@code {
    /// <summary>
    /// The currently active role name. Comparison is case-insensitive.
    /// </summary>
    [Parameter]
    public EngineeringRole ActiveRole { get; set; } = EngineeringRole.Architect;

    /// <summary>
    /// Optional callback invoked when the active role changes.
    /// </summary>
    [Parameter]
    public EventCallback<EngineeringRole> ActiveRoleChanged { get; set; }

    /// <summary>
    /// Roles to render. Defaults to the core engineering roles.
    /// </summary>
    [Parameter]
    public IEnumerable<EngineeringRole>? Items { get; set; }

    /// <summary>
    /// Optional additional content rendered below the role list (e.g. sections like Engineering Assets).
    /// </summary>
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    private static readonly EngineeringRole[] DefaultRoles = new[] { EngineeringRole.CurrentTask, EngineeringRole.Architect, EngineeringRole.Planner, EngineeringRole.Developer, EngineeringRole.Verifier, EngineeringRole.Reviewer };

    private IEnumerable<EngineeringRole> ItemsResolved => Items ?? DefaultRoles;

    private static string GetRoleName(EngineeringRole role) => role switch
    {
        EngineeringRole.CurrentTask => "Current Task",
        _ => role.ToString()
    };

    private async Task SelectRole(EngineeringRole role)
    {
        if (role == ActiveRole) return;

        ActiveRole = role;
        if (ActiveRoleChanged.HasDelegate)
        {
            await ActiveRoleChanged.InvokeAsync(role);
        }
    }

    private async Task OnKeyDown(KeyboardEventArgs e, EngineeringRole role)
    {
        if (e.Key == "Enter" || e.Key == " ")
        {
            await SelectRole(role);
        }
    }
}
