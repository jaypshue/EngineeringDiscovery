@using EngineeringDiscovery.Core.Domain.Investigation
@using System.Text.RegularExpressions
@using System.Linq
@namespace EngineeringDiscovery.Web.Components.Dashboard



<div class="investigation-dashboard">
    <h3>Investigation: @(ViewModel?.Summary.Target ?? "(unknown)")</h3>

    <div class="summary-cards" style="display:flex; gap:12px; margin-bottom:12px;">
        <div class="card">Repository<br/><strong>@(ViewModel?.Summary.Repository ?? "")</strong></div>
        <div class="card">Solution<br/><strong>@(ViewModel?.Summary.Solution ?? "")</strong></div>
        <div class="card">Projects<br/><strong>@(ViewModel?.Summary.ProjectCount.ToString() ?? "0")</strong></div>
        <div class="card">Namespaces<br/><strong>@(ViewModel?.Summary.NamespaceCount.ToString() ?? "0")</strong></div>
        <div class="card">Types<br/><strong>@(ViewModel?.Summary.TypeCount.ToString() ?? "0")</strong></div>
        <div class="card">Members<br/><strong>@(ViewModel?.Summary.MemberCount.ToString() ?? "0")</strong></div>
        <div class="card">Technologies<br/><strong>@(ViewModel?.Summary.TechnologyCount.ToString() ?? "0")</strong></div>
        <div class="card">Findings<br/><strong>@(ViewModel?.Summary.FindingCount.ToString() ?? "0")</strong></div>
    </div>

    <div style="margin-bottom:8px;">
        <input placeholder="Search discovery..." @bind="SearchTerm" style="width:100%; padding:6px;" />
    </div>

    <div style="display:flex; gap:16px;">
        <div style="width:320px; border-right:1px solid #ddd; padding-right:12px;">
            <h4>Project Explorer</h4>
            @if (!(ViewModel?.Projects?.Any() ?? false))
            {
                <p class="muted">No projects discovered.</p>
            }
            else
            {
                <ul>
                    @foreach (var p in (ViewModel?.Projects?.OrderBy(p => p.Key) ?? Enumerable.Empty<KeyValuePair<string, EngineeringDiscovery.Web.Components.Dashboard.ViewModels.ProjectNodeViewModel>>()))
                    {
                        <li>
                            <button class="link" @onclick="() => ToggleProject(p.Key)">@((ExpandedProjects.Contains(p.Key) ? "▼" : "▶"))</button>
                            <strong>@p.Key</strong>
                            @if (ExpandedProjects.Contains(p.Key))
                            {
                                <ul>
                                    @foreach (var ns in p.Value.Namespaces.OrderBy(n => n.Key))
                                    {
                                        if (!MatchesFilter(ns.Key)) continue;
                                        <li>
                                            <button class="link" @onclick="() => ToggleNamespace(p.Key, ns.Key)">@((ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)) ? "▼" : "▶"))</button>
                                            @ns.Key
                                            @if (ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)))
                                            {
                                                <ul>
                                                    @foreach (var t in ns.Value.Types.OrderBy(t => t.Key))
                                                    {
                                                        if (!MatchesFilter(t.Key)) continue;
                                                        <li>
                                                            <button class="link" @onclick="() => ToggleType(p.Key, ns.Key, t.Key)">@((ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)) ? "▼" : "▶"))</button>
                                                            @t.Key (@t.Value.Kind)
                                                            @if (ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)))
                                                            {
                                                                <ul>
                                                                    @foreach (var m in t.Value.Members)
                                                                    {
                                                                        if (!MatchesFilter(m)) continue;
                                                                        <li>@m</li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            }
        </div>

        <div style="flex:1; padding-left:12px;">
            <h4>Discovery Tree</h4>

            @if (!(ViewModel?.Projects?.Any() ?? false))
            {
                <p class="muted">No discovery observations available.</p>
            }
            else
            {
                <div>
                    @foreach (var p in ViewModel.Projects.OrderBy(kv => kv.Key))
                    {
                        <div style="margin-bottom:8px;">
                            <div>
                                <button class="link" @onclick="() => ToggleProject(p.Key)">@((ExpandedProjects.Contains(p.Key) ? "▼" : "▶"))</button>
                                <strong>@p.Key</strong>
                            </div>
                            @if (ExpandedProjects.Contains(p.Key))
                            {
                                <div style="margin-left:16px; margin-top:6px;">
                                    @if (p.Value.Observations.Any())
                                    {
                                        <details>
                                            <summary>Project Observations (@p.Value.Observations.Count)</summary>
                                            <ul>
                                                @foreach (var o in p.Value.Observations)
                                                {
                                                    if (!MatchesFilter(o)) continue;
                                                    <li>@o</li>
                                                }
                                            </ul>
                                        </details>
                                    }

                                    @foreach (var ns in p.Value.Namespaces.OrderBy(n => n.Key))
                                    {
                                        <div style="margin-top:6px;">
                                            <button class="link" @onclick="() => ToggleNamespace(p.Key, ns.Key)">@((ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)) ? "▼" : "▶"))</button>
                                            <em>@ns.Key</em>
                                            @if (ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)))
                                            {
                                                <div style="margin-left:16px; margin-top:6px;">
                                                    @if (ns.Value.Observations.Any())
                                                    {
                                                        <details>
                                                            <summary>Namespace Observations (@ns.Value.Observations.Count)</summary>
                                                            <ul>
                                                                @foreach (var o in ns.Value.Observations)
                                                                {
                                                                    if (!MatchesFilter(o)) continue;
                                                                    <li>@o</li>
                                                                }
                                                            </ul>
                                                        </details>
                                                    }

                                                    @foreach (var t in ns.Value.Types.OrderBy(t => t.Key))
                                                    {
                                                        <div style="margin-top:4px;">
                                                            <button class="link" @onclick="() => ToggleType(p.Key, ns.Key, t.Key)">@((ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)) ? "▼" : "▶"))</button>
                                                            <span>@t.Key (@t.Value.Kind)</span>
                                                            @if (ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)))
                                                            {
                                                                <div style="margin-left:12px; margin-top:4px;">
                                                                    @if (t.Value.Observations.Any())
                                                                    {
                                                                        <details>
                                                                            <summary>Type Observations (@t.Value.Observations.Count)</summary>
                                                                            <ul>
                                                                                @foreach (var o in t.Value.Observations)
                                                                                {
                                                                                    if (!MatchesFilter(o)) continue;
                                                                                    <li>@o</li>
                                                                                }
                                                                            </ul>
                                                                        </details>
                                                                    }

                                                                    @if (t.Value.Members.Any())
                                                                    {
                                                                        <div>
                                                                            <strong>Members</strong>
                                                                            <ul>
                                                                                @foreach (var m in t.Value.Members)
                                                                                {
                                                                                    if (!MatchesFilter(m)) continue;
                                                                                    <li>@m</li>
                                                                                }
                                                                            </ul>
                                                                        </div>
                                                                    }
                                                                </div>
                                                            }
                                                        </div>
                                                    }
                                                </div>
                                            }
                                        </div>
                                    }
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
