@using EngineeringDiscovery.Core.Domain.Investigation
@using System.Text.RegularExpressions
@using System.Linq
@namespace EngineeringDiscovery.Web.Components.Dashboard



<div class="investigation-workbench">
    <p style="color:red">
        DEBUG:
        @(ViewModel?.Summary.ProjectCount)
        /
        @(ViewModel?.Summary.NamespaceCount)
        /
        @(ViewModel?.Summary.TypeCount)
    </p>
    <header class="workbench-header">
        <h3>Investigation: @(ViewModel?.Summary.Target ?? "(unknown)")</h3>
    </header>

    <section class="summary-cards">
        <div class="card">Repository<br/><strong>@(ViewModel?.Summary.Repository ?? "")</strong></div>
        <div class="card">Solution<br/><strong>@(ViewModel?.Summary.Solution ?? "")</strong></div>
        <div class="card">Projects<br/><strong>@(ViewModel?.Summary.ProjectCount.ToString() ?? "0")</strong></div>
        <div class="card">Namespaces<br/><strong>@(ViewModel?.Summary.NamespaceCount.ToString() ?? "0")</strong></div>
        <div class="card">Types<br/><strong>@(ViewModel?.Summary.TypeCount.ToString() ?? "0")</strong></div>
        <div class="card">Members<br/><strong>@(ViewModel?.Summary.MemberCount.ToString() ?? "0")</strong></div>
        <div class="card">Technologies<br/><strong>@(ViewModel?.Summary.TechnologyCount.ToString() ?? "0")</strong></div>
        <div class="card">Findings<br/><strong>@(ViewModel?.Summary.FindingCount.ToString() ?? "0")</strong></div>
    </section>

    <section class="workbench-toolbar">
        <input class="search-input" placeholder="Search discovery..." @bind="SearchTerm" />
    </section>

    <section class="workbench-panels">
        <aside class="panel panel-explorer">
            <h4>Explorer</h4>
            @if (!(ViewModel?.Projects?.Any() ?? false))
            {
                <p class="muted">No projects discovered.</p>
            }
            else
            {
                <ul class="tree-root">
                    @foreach (var p in (ViewModel?.Projects?.OrderBy(p => p.Key) ?? Enumerable.Empty<KeyValuePair<string, EngineeringDiscovery.Web.Components.Dashboard.ViewModels.ProjectNodeViewModel>>()))
                    {
                        <li class="tree-node project-node">
                            <div class="node-row">
                                <button class="link tree-toggle" @onclick="() => ToggleProject(p.Key)">@((ExpandedProjects.Contains(p.Key) ? "▼" : "▶"))</button>
                                <button class="link node-select" @onclick="() => SelectProject(p.Key)"><strong>@p.Key</strong></button>
                            </div>
                            @if (ExpandedProjects.Contains(p.Key))
                            {
                                <ul>
                                    @foreach (var ns in p.Value.Namespaces.OrderBy(n => n.Key))
                                    {
                                        if (!MatchesFilter(ns.Key)) continue;
                                        <li class="tree-node namespace-node">
                                            <div class="node-row">
                                                <button class="link tree-toggle" @onclick="() => ToggleNamespace(p.Key, ns.Key)">@((ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)) ? "▼" : "▶"))</button>
                                                <button class="link node-select" @onclick="() => SelectNamespace(p.Key, ns.Key)">@ns.Key</button>
                                            </div>
                                            @if (ExpandedNamespaces.Contains(GetNamespaceIdPublic(p.Key, ns.Key)))
                                            {
                                                <ul>
                                                    @foreach (var t in ns.Value.Types.OrderBy(t => t.Key))
                                                    {
                                                        if (!MatchesFilter(t.Key)) continue;
                                                        <li class="tree-node type-node">
                                                            <div class="node-row">
                                                                <button class="link tree-toggle" @onclick="() => ToggleType(p.Key, ns.Key, t.Key)">@((ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)) ? "▼" : "▶"))</button>
                                                                <button class="link node-select" @onclick="() => SelectType(p.Key, ns.Key, t.Key)">@t.Key (@t.Value.Kind)</button>
                                                            </div>
                                                            @if (ExpandedTypes.Contains(GetTypeIdPublic(p.Key, ns.Key, t.Key)))
                                                            {
                                                                <ul>
                                                                    @foreach (var m in t.Value.Members)
                                                                    {
                                                                        if (!MatchesFilter(m)) continue;
                                                                        <li class="tree-node member-node">
                                                                            <button class="link node-select" @onclick="() => SelectMember(p.Key, ns.Key, t.Key, m)">@m</button>
                                                                        </li>
                                                                    }
                                                                </ul>
                                                            }
                                                        </li>
                                                    }
                                                </ul>
                                            }
                                        </li>
                                    }
                                </ul>
                            }
                        </li>
                    }
                </ul>
            }
        </aside>

        <section class="panel panel-details">
            <h4>Details</h4>
            @if (SelectedNodeType == NodeType.None)
            {
                <p class="muted">Select a node in the explorer to view details.</p>
            }
            else
            {
                <div class="details-card">
                    <h5>@SelectedDetailsTitle</h5>
                    <dl>
                        @foreach (var item in SelectedDetails)
                        {
                            <dt>@item.Key</dt>
                            <dd>@item.Value</dd>
                        }
                    </dl>
                    <h6>Investigation Summary</h6>
                    @if (Investigation is not null)
                    {
                        var invSummary = EngineeringDiscovery.Core.Domain.Investigation.InvestigationSummary.CreateFrom(Investigation);
                        <dl>
                            <dt>Repository</dt>
                            <dd>@invSummary.RepositoryName</dd>
                            <dt>Projects</dt>
                            <dd>@invSummary.ProjectCount</dd>
                            <dt>Namespaces</dt>
                            <dd>@invSummary.NamespaceCount</dd>
                            <dt>Types</dt>
                            <dd>@invSummary.TypeCount</dd>
                            <dt>Members</dt>
                            <dd>@invSummary.MemberCount</dd>
                        </dl>

                        <h6>Engineering Summary</h6>
                        <dl>
                            <dt>Total Artifacts</dt>
                            <dd>@invSummary.TotalArtifacts</dd>
                            <dt>Layer Violations</dt>
                            <dd>@invSummary.LayerViolations</dd>
                            <dt>Circular Project References</dt>
                            <dd>@invSummary.CircularProjectReferences</dd>
                            <dt>Empty Controllers</dt>
                            <dd>@invSummary.EmptyControllers</dd>
                            <dt>Long Methods</dt>
                            <dd>@invSummary.LongMethods</dd>
                        </dl>
                    }

                    <h6>Engineering Artifacts</h6>
                    @if (Investigation?.Artifacts == null || !Investigation.Artifacts.Any())
                    {
                        <p class="muted">No engineering artifacts produced.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var a in Investigation.Artifacts.OrderByDescending(x => x.CreatedOn))
                            {
                                <li>
                                    <strong>@a.Title</strong>
                                    <div>@a.Description</div>
                                    <small>@a.CreatedOn.ToLocalTime().ToString("s")</small>
                                </li>
                            }
                        </ul>
                    }
                    @if (SelectedObservations?.Any() ?? false)
                    {
                        <h6>Observations</h6>
                        <ul>
                            @foreach (var observation in SelectedObservations)
                            {
                                <li>@observation</li>
                            }
                        </ul>
                    }
                </div>
            }
        </section>

        <aside class="panel panel-findings">
            <h4>Findings</h4>
            @if (!(ViewModel?.Findings?.Any() ?? false))
            {
                <p class="muted">No findings categorized beyond observations.</p>
            }
            else
            {
                @foreach (var group in ViewModel!.Findings.GroupBy(f => f.Type))
                {
                    <div class="finding-group">
                        <h5>@group.Key (@group.Count())</h5>
                        <ul>
                            @foreach (var finding in group)
                            {
                                <li>@finding.Description</li>
                            }
                        </ul>
                    </div>
                }
            }
        </aside>
    </section>
</div>

