@namespace EngineeringDiscovery.Web.Components.Workspaces

@using EngineeringDiscovery.Core.Domain.Investigation
@using System
@using System.Linq
@using System.Collections.Generic

@code {
    [Parameter]
    public Investigation? Investigation { get; set; }

    [Inject]
    private EngineeringDiscovery.Web.Services.InvestigationState InvestigationState { get; set; } = null!;

    private IReadOnlyList<object> Findings =>
        (Investigation ?? InvestigationState.Investigation)?.Findings?.Cast<object>().ToList() ?? new List<object>();

    private int FindingCount => Findings.Count;

    private IEnumerable<string> CoverageAreas =>
        Findings
            .Select(GetFindingArea)
            .Where(area => !string.IsNullOrWhiteSpace(area))
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .OrderBy(area => area);

    private IDictionary<string, int> EvidenceSummary =>
        CoverageAreas.ToDictionary(
            area => area,
            area => Findings.Count(finding =>
                string.Equals(GetFindingArea(finding), area, StringComparison.OrdinalIgnoreCase)));

    private bool HasOpenQuestions =>
        CoverageAreas.Any(area => area.Contains("question", StringComparison.OrdinalIgnoreCase));

    private string GoalVerification =>
        FindingCount switch
        {
            0 => "No evidence has been captured yet for this investigation target.",
            _ when HasOpenQuestions => "Evidence exists, but open questions still affect confidence in goal verification.",
            _ => "Available evidence supports verification of the investigation target."
        };

    private string CompletionAssessment =>
        FindingCount switch
        {
            0 => "Additional investigation required",
            _ when HasOpenQuestions => "Partially complete",
            _ => "Complete"
        };

    private string VerificationResult =>
        CompletionAssessment switch
        {
            "Complete" => "Verified",
            "Partially complete" => "Conditionally verified",
            _ => "Not verified"
        };

    private static string GetFindingArea(object finding)
    {
        var typeProperty = finding.GetType().GetProperty("Type");
        var typeValue = typeProperty?.GetValue(finding)?.ToString();
        return string.IsNullOrWhiteSpace(typeValue) ? finding.GetType().Name : typeValue;
    }
}

<section class="workspace workspace--verifier">
    <h3>Verifier Workspace</h3>
    <p>
        Verification for:
        <strong>@Investigation.Target</strong>
    </p>

    <section class="workspace__section">
        <h4>Verification Report</h4>

        <h5>1. Goal Verification</h5>
        <p>@GoalVerification</p>

        <h5>2. Evidence Summary</h5>
        <p><strong>Total findings:</strong> @FindingCount</p>
        @if (!EvidenceSummary.Any())
        {
            <p>No categorized evidence is available.</p>
        }
        else
        {
            <ul>
                @foreach (var summaryItem in EvidenceSummary)
                {
                    <li>@summaryItem.Key: @summaryItem.Value</li>
                }
            </ul>
        }

        <h5>3. Coverage Assessment</h5>
        @if (!CoverageAreas.Any())
        {
            <p>No coverage areas identified from findings.</p>
        }
        else
        {
            <p>Evidence coverage includes:</p>
            <ul>
                @foreach (var area in CoverageAreas)
                {
                    <li>@area</li>
                }
            </ul>
        }

        <h5>4. Completion Assessment</h5>
        <p>@CompletionAssessment</p>

        <h5>5. Verification Result</h5>
        <p>@VerificationResult</p>
    </section>
</section>
