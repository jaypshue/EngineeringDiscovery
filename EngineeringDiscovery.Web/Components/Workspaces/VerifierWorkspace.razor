@namespace EngineeringDiscovery.Web.Components.Workspaces

@using EngineeringDiscovery.Core.Domain.Investigation

@code {
    [Parameter, EditorRequired]
    public Investigation Investigation { get; set; } = default!;
}

<section class="workspace workspace--verifier">
    <h3>Verifier Workspace</h3>
    <p>
        Verification for:
        <strong>@Investigation.Target</strong>
    </p>

    <p>
        Verification functionality will be introduced in ED-111.
    </p>

    <section class="workspace__section">
        <h4>Test Runs</h4>
        <p>Placeholder for test execution results and status.</p>
    </section>

    <section class="workspace__section">
        <h4>Checks</h4>
        <p>Placeholder for verification checklists and evidence collection.</p>
    </section>

    <section class="workspace__section">
        <h4>Reports</h4>
        <p>Placeholder for verification reports and summaries.</p>
    </section>
</section>
