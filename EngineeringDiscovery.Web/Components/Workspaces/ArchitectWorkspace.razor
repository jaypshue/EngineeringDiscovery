@using EngineeringDiscovery.Core.Domain.Investigation
@namespace EngineeringDiscovery.Web.Components.Workspaces

@using System
@using EngineeringDiscovery.Core.Domain
@using EngInv = EngineeringDiscovery.Core.Domain.Investigation

@code {
    [Parameter]
    public EngInv.Investigation? Investigation { get; set; }

    [Inject]
    private EngineeringDiscovery.Web.Services.WorkspaceState WorkspaceState { get; set; } = null!;

    private string? ErrorMessage { get; set; }

    private string NewFindingDescription { get; set; } = string.Empty;
    private EngInv.FindingType NewFindingType { get; set; } = EngInv.FindingType.Observation;

    private void ClearError() => ErrorMessage = null;

    private void HandleException(InvalidOperationException ex)
    {
        ErrorMessage = ex.Message;
    }



    private void Complete()
    {
        try
        {
            (Investigation ?? WorkspaceState.ActiveWorkspace?.Investigation)!.Complete();
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void Reopen()
    {
        try
        {
            (Investigation ?? WorkspaceState.ActiveWorkspace?.Investigation)!.Reopen();
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void SetStage(Action<EngineeringStageStatus> setter, ChangeEventArgs e)
    {
        try
        {
            var value = Enum.Parse<EngineeringStageStatus>(e?.Value?.ToString() ?? EngineeringStageStatus.NotStarted.ToString());
            setter(value);
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void AddFinding()
    {
        try
        {
            var desc = NewFindingDescription?.Trim();
            if (string.IsNullOrEmpty(desc)) return; // nothing to add
            var f = new EngInv.Finding(Guid.NewGuid(), NewFindingType, desc);
            (Investigation ?? WorkspaceState.ActiveWorkspace?.Investigation)!.AddFinding(f);
            NewFindingDescription = string.Empty;
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }
}

<section class="workspace workspace--architect">
    <h3>Architect Workspace</h3>
    <p>The Architect focuses on high level design, system boundaries, and technical decisions that shape the investigation.</p>

    <InvestigationDashboard Investigation="@Investigation" />
    <InvestigationSummary Investigation="@Investigation" />

    <div class="add-finding">
        <select @bind="NewFindingType">
            <option value="Architecture">Architecture</option>
            <option value="Risk">Risk</option>
            <option value="Decision">Decision</option>
            <option value="Question">Question</option>
            <option value="Dependency">Dependency</option>
            <option value="TechnicalDebt">Technical Debt</option>
            <option value="Observation">Observation</option>
        </select>

        <input @bind="NewFindingDescription" placeholder="New finding description" />
        <button class="btn" @onclick="AddFinding">Add Finding</button>
    </div>

    <section class="workspace__section">
        <h4>Design Canvas</h4>
        <p>Placeholder for diagrams, architecture notes, and design artifacts.</p>
    </section>

    <section class="workspace__section">
        <h4>Decision Log</h4>
        <p>Placeholder for recording architectural decisions and rationale.</p>
    </section>

    <section class="workspace__section">
        <h4>Constraints & Assumptions</h4>
        <p>Placeholder for listing constraints, assumptions, and trade-offs.</p>
    </section>
</section>
