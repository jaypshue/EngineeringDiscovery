@using EngineeringDiscovery.Core.Services
@using EngineeringDiscovery.Web.Components.Shared
@namespace EngineeringDiscovery.Web.Components.Workspaces
@inject WorkspaceState WorkspaceState
@using EngineeringDiscovery.Web.Components.Dashboard
@* IterationWorkspace is intentionally lightweight and additive. It attaches to the active workspace and
   provides a small surface for recording goals, evidence, and next actions without modifying existing flows. *@
@using EngineeringDiscovery.Web.Components.Workspaces

<div class="recommendation-workspace ed-workspace">
    <CurrentTaskHeader />

    <div class="conversation-first" style="display:flex;flex-direction:column;gap:12px;max-width:1100px;margin:0 auto">
        <!-- Conversation (primary) -->
        <section class="conversation-section">
            <ConversationArea />
        </section>

        <!-- Recommendation immediately follows conversation and remains adjacent visually -->
        <section class="recommendation-section">
            <RecommendationCard Title="Suggested next action" Rationale="EngineOS suggests this next step based on current analysis." />
        </section>

        <!-- Current Understanding follows recommendation -->
        <section class="understanding-section">
            <CurrentUnderstandingCard Investigation="WorkspaceState.ActiveWorkspace?.Investigation" />
        </section>

        <!-- Artifacts: collapsed work contract to keep it visually secondary -->
        <section class="artifacts-section">
            <details class="artifacts-details">
                <summary>Artifacts (Work Contract)</summary>
                <div style="margin-top:8px">
                    <WorkContractEditor />
                </div>
            </details>
        </section>

        <!-- Lightweight Engineering Iteration surface (MVP) -->
        <section class="iteration-section">
            <IterationWorkspace />
        </section>

        <!-- Explorer: InvestigationDashboard (lightweight entry to Explorer mode) -->
        @{ var inv = WorkspaceState.ActiveWorkspace?.Investigation; }
        @if (inv is not null && (
                (inv.TypeObservations != null && inv.TypeObservations.Any()) ||
                (inv.NamespaceObservations != null && inv.NamespaceObservations.Any()) ||
                (inv.MemberObservations != null && inv.MemberObservations.Any())))
        {
            <section class="explorer-section">
                <details>
                    <summary class="link">Explorer</summary>
                    <div style="margin-top:8px">
                        <InvestigationDashboard Investigation="inv" />
                    </div>
                </details>
            </section>
        }
    </div>
</div>
