@using EngineeringDiscovery.Core.Domain.CurrentTask
@using EngineeringDiscovery.Web.Services
@using EngineeringDiscovery.Core.Services
@namespace EngineeringDiscovery.Web.Components.Workspaces

<section class="workspace workspace--current-task">
    <h3>Current Task</h3>

    @if (ActiveTask is null)
    {
        <section class="workspace__section">
            <h4>Begin Engineering Work</h4>
            <p>No Current Task is active. Begin a task to capture the engineering intent for the work you are about to perform.</p>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p class="error">@ErrorMessage</p>
            }

            <div class="task-form">
                <label>
                    Title
                    <input @bind="Title" placeholder="Short task title" />
                </label>
                <label>
                    Description
                    <textarea @bind="Description" placeholder="What work is being performed?"></textarea>
                </label>
                <label>
                    Goal
                    <textarea @bind="Goal" placeholder="What outcome should this work produce?"></textarea>
                </label>
                <button class="btn" @onclick="StartTask">Begin Current Task</button>
            </div>
        </section>
    }
    else
    {
        <section class="workspace__section">
            <h4>@ActiveTask.Title</h4>
            <dl>
                <dt>Description</dt>
                <dd>@ActiveTask.Description</dd>
                <dt>Goal</dt>
                <dd>@ActiveTask.Goal</dd>
                <dt>Status</dt>
                <dd>@ActiveTask.Status</dd>
            </dl>
            <button class="btn" @onclick="CompleteTask">Complete Task</button>

            <section class="workspace__section workspace__section--brief">
                <h5>Engineering Brief</h5>
                <label>
                    Objective
                    <input value="@BriefObjective" @oninput="OnObjectiveChanged" placeholder="Short objective" />
                </label>
                <label>
                    Notes
                    <textarea @bind="BriefNotes" placeholder="Notes about the work"></textarea>
                </label>
                <label>
                    Implementation Thoughts
                    <textarea @bind="BriefImplementation" placeholder="Ideas for implementation"></textarea>
                </label>
                <div class="brief-actions">
                    <button class="btn" @onclick="SaveBrief">Save Brief</button>
                </div>
                <div class="engineering-context">
                    <h6>Engineering Context</h6>
                    @if (ActiveTask?.Brief?.Context == null || ActiveTask.Brief.Context.IsEmpty())
                    {
                        <p>No engineering context selected.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var pid in ActiveTask.Brief.Context.ProjectIds)
                            {
                                <li>@pid <button class="btn--small" @onclick="() => RemoveProject(pid)">Remove</button></li>
                            }
                            @foreach (var nid in ActiveTask.Brief.Context.NamespaceIds)
                            {
                                <li>@nid <button class="btn--small" @onclick="() => RemoveNamespace(nid)">Remove</button></li>
                            }
                            @foreach (var tid in ActiveTask.Brief.Context.TypeIds)
                            {
                                <li>@tid <button class="btn--small" @onclick="() => RemoveType(tid)">Remove</button></li>
                            }
                        </ul>
                    }
                    <div class="add-context">
                    <label>
                            Add Context (enter identifier):
                            <input @bind="ContextQuery" placeholder="Enter project / namespace / type id" />
                        </label>
                        <div class="context-kind">
                            <label>
                                Kind
                                <select @bind="SelectedContextKind">
                                    <option value="Project">Project</option>
                                    <option value="Namespace">Namespace</option>
                                    <option value="Type">Type</option>
                                </select>
                            </label>
                        </div>
                        <div class="context-results">
                            @if (ContextResults?.Any() == true)
                            {
                                <ul>
                                    @foreach (var r in ContextResults)
                                    {
                                        <li>@r <button class="btn--small" @onclick="() => AddContextItem(r)">Add</button></li>
                                    }
                                </ul>
                            }
                            <div class="context-add-inline">
                                <button class="btn" @onclick="() => AddContextItem(ContextQuery)">Add</button>
                            </div>
                        </div>
                    </div>
                        <div class="recommendations">
                            <h6>Recommendations</h6>
                            @foreach (var rec in RecommendationService.RecommendTypes(WorkspaceState.ActiveWorkspace))
                            {
                                <div class="recommendation">
                                    <span>@rec</span>
                                    <button class="btn--small" @onclick="() => AcceptRecommendation(rec)">Add</button>
                                </div>
                            }
                        </div>
                        <div class="insights">
                            <h6>Engineering Insights</h6>
                            @foreach (var ins in InsightService.GetInsights(WorkspaceState.ActiveWorkspace))
                            {
                                <div class="insight">
                                    <strong>@ins.Subject</strong>
                                    <div class="muted">@ins.Category</div>
                                    <div>@ins.Observation</div>
                                </div>
                            }
                        </div>
                    <div class="advisor">
                        <h6>Engineering Advisor</h6>
                        <label>
                            Ask a question
                            <input @bind="AdvisorQuestion" placeholder="e.g., Why was type X recommended?" />
                        </label>
                        <button class="btn" @onclick="AskAdvisor">Ask</button>

                        @if (AdvisorLastResponse is not null)
                        {
                            <div class="advisor-response">
                                <h5>Engineering Evidence</h5>
                                <ul>
                                    @foreach (var e in AdvisorLastResponse.Evidence)
                                    {
                                        <li><strong>@e.Title</strong>: @e.Detail</li>
                                    }
                                </ul>

                                <h5>Advisor Interpretation</h5>
                                <div>@AdvisorLastResponse.Interpretation</div>
                            </div>
                        }
                    </div>
                </div>
            </section>
        </section>
    }
</section>

@code {
    [Inject]
    private EngineeringDiscovery.Core.Services.WorkspaceState WorkspaceState { get; set; } = null!;

    [Inject]
    private ICurrentTaskService CurrentTaskService { get; set; } = null!;

    [Inject]
    private EngineeringDiscovery.Web.Services.EngineeringInsightService InsightService { get; set; } = null!;

    [Inject]
    private EngineeringDiscovery.Web.Services.EngineeringRecommendationService RecommendationService { get; set; } = null!;

    [Inject]
    private EngineeringDiscovery.Web.Services.EngineeringAdvisorService AdvisorService { get; set; } = null!;

    private CurrentTask? ActiveTask => WorkspaceState.ActiveWorkspace?.CurrentTask;

    private string Title { get; set; } = string.Empty;

    private string Description { get; set; } = string.Empty;

    private string Goal { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }

    // Engineering Brief editor backing fields
    private string BriefObjective { get; set; } = string.Empty;
    private string BriefNotes { get; set; } = string.Empty;
    private string BriefImplementation { get; set; } = string.Empty;
    private string ContextQuery { get; set; } = string.Empty;
    private string[] ContextResults { get; set; } = Array.Empty<string>();
    private string SelectedContextKind { get; set; } = "Type";
    private string? SelectedProjectOption { get; set; }
    private string? SelectedNamespaceOption { get; set; }
    private string? SelectedTypeOption { get; set; }

    private IEnumerable<string> ProjectOptions => WorkspaceState.ActiveWorkspace?.Investigation is null
        ? Enumerable.Empty<string>()
        : (WorkspaceState.ActiveWorkspace.Investigation.TypeObservations?.Select(t => t.Project).Where(p => !string.IsNullOrWhiteSpace(p)).Distinct(StringComparer.OrdinalIgnoreCase) ?? Enumerable.Empty<string>());

    private IEnumerable<string> NamespaceOptions => WorkspaceState.ActiveWorkspace?.Investigation is null
        ? Enumerable.Empty<string>()
        : (WorkspaceState.ActiveWorkspace.Investigation.NamespaceObservations?.Select(n => n.NamespaceName).Where(nm => !string.IsNullOrWhiteSpace(nm)).Distinct(StringComparer.OrdinalIgnoreCase)
            ?? WorkspaceState.ActiveWorkspace.Investigation.TypeObservations?.Select(t => t.Namespace).Where(nm => !string.IsNullOrWhiteSpace(nm)).Distinct(StringComparer.OrdinalIgnoreCase) ?? Enumerable.Empty<string>());

    private IEnumerable<string> TypeOptions => WorkspaceState.ActiveWorkspace?.Investigation is null
        ? Enumerable.Empty<string>()
        : (WorkspaceState.ActiveWorkspace.Investigation.TypeObservations?.Select(t => t.QualifiedName ?? (string.IsNullOrWhiteSpace(t.Namespace) ? t.TypeName : t.Namespace + "." + t.TypeName)).Where(q => !string.IsNullOrWhiteSpace(q)).Distinct(StringComparer.OrdinalIgnoreCase) ?? Enumerable.Empty<string>());

    protected override void OnInitialized()
    {
        WorkspaceState.OnChange += OnCurrentTaskChanged;
        if (ActiveTask is not null)
        {
            LoadBriefFromActiveTask();
        }
    }

    private async Task UpdateContextResults()
    {
        // V1: simple echo search (replace with InvestigationState lookup later)
        if (string.IsNullOrWhiteSpace(ContextQuery) || ActiveTask is null)
        {
            ContextResults = Array.Empty<string>();
            return;
        }

        ContextResults = new[] { ContextQuery };
    }

    private void AddContextItem(string id)
    {
        if (ActiveTask is null) return;

        CurrentTaskService.UpdateBriefAsync(b =>
        {
            switch (SelectedContextKind)
            {
                case "Project":
                    b.Context.AddProject(id);
                    break;
                case "Namespace":
                    b.Context.AddNamespace(id);
                    break;
                default:
                    b.Context.AddType(id);
                    break;
            }

            b.Touch();
        }).GetAwaiter().GetResult();
    }

    private void AddProjectFromSelect()
    {
        if (string.IsNullOrWhiteSpace(SelectedProjectOption) || ActiveTask is null) return;
        CurrentTaskService.AddContextAsync("Project", SelectedProjectOption!).GetAwaiter().GetResult();
        SelectedProjectOption = null;
    }

    private void AddNamespaceFromSelect()
    {
        if (string.IsNullOrWhiteSpace(SelectedNamespaceOption) || ActiveTask is null) return;
        CurrentTaskService.AddContextAsync("Namespace", SelectedNamespaceOption!).GetAwaiter().GetResult();
        SelectedNamespaceOption = null;
    }

    private void AddTypeFromSelect()
    {
        if (string.IsNullOrWhiteSpace(SelectedTypeOption) || ActiveTask is null) return;
        CurrentTaskService.AddContextAsync("Type", SelectedTypeOption!).GetAwaiter().GetResult();
        SelectedTypeOption = null;
    }

    private void RemoveProject(string id)
    {
        if (ActiveTask is null) return;
        CurrentTaskService.UpdateBriefAsync(b => { b.Context.RemoveProject(id); b.Touch(); }).GetAwaiter().GetResult();
    }

    private void RemoveNamespace(string id)
    {
        if (ActiveTask is null) return;
        CurrentTaskService.UpdateBriefAsync(b => { b.Context.RemoveNamespace(id); b.Touch(); }).GetAwaiter().GetResult();
    }

    private void RemoveType(string id)
    {
        if (ActiveTask is null) return;
        CurrentTaskService.UpdateBriefAsync(b => { b.Context.RemoveType(id); b.Touch(); }).GetAwaiter().GetResult();
    }


    private async Task StartTask()
    {
        ErrorMessage = null;

        try
        {
                // Use WorkspaceState for now; host will be wired to call ICurrentTaskService in a later iteration.
                await CurrentTaskService.BeginTaskAsync(Title, Description, Goal);
            Title = string.Empty;
            Description = string.Empty;
            Goal = string.Empty;
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void AcceptRecommendation(string qualifiedName)
    {
        if (ActiveTask is null) return;
        // Recommendations are types; add them as Type context
        CurrentTaskService.AddContextAsync("Type", qualifiedName).GetAwaiter().GetResult();
    }

    // Simple advisor interaction model: ask a question and display response modal (rudimentary)
    private string AdvisorQuestion { get; set; } = string.Empty;
    private AdvisorResponse? AdvisorLastResponse { get; set; }

    private void AskAdvisor()
    {
        if (string.IsNullOrWhiteSpace(AdvisorQuestion)) return;
        AdvisorLastResponse = AdvisorService.Ask(AdvisorQuestion, WorkspaceState.ActiveWorkspace);
        AdvisorQuestion = string.Empty;
    }

    private async Task CompleteTask()
    {
        await CurrentTaskService.CompleteTaskAsync();
    }

    private void OnCurrentTaskChanged()
    {
        LoadBriefFromActiveTask();
        InvokeAsync(StateHasChanged);
    }

    private void LoadBriefFromActiveTask()
    {
        if (ActiveTask is null)
        {
            BriefObjective = string.Empty;
            BriefNotes = string.Empty;
            BriefImplementation = string.Empty;
            return;
        }

        BriefObjective = ActiveTask.Brief.Objective;
        BriefNotes = ActiveTask.Brief.Notes;
        BriefImplementation = ActiveTask.Brief.ImplementationThoughts;
    }

    private void OnObjectiveChanged(ChangeEventArgs e)
    {
        BriefObjective = e?.Value?.ToString() ?? string.Empty;
    }

    private void SaveBrief()
    {
        if (ActiveTask is null) return;

        // Update via CurrentTaskService to keep workflow and persistence centralized
        CurrentTaskService.UpdateBriefAsync(b =>
        {
            b.Objective = BriefObjective ?? string.Empty;
            b.Notes = BriefNotes ?? string.Empty;
            b.ImplementationThoughts = BriefImplementation ?? string.Empty;
            b.Touch();
        }).GetAwaiter().GetResult();
    }

    public void Dispose()
    {
        WorkspaceState.OnChange -= OnCurrentTaskChanged;
    }
}
