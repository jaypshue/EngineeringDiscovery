@using EngineeringDiscovery.Core.Domain.CurrentTask
@namespace EngineeringDiscovery.Web.Components.Workspaces

<section class="workspace workspace--current-task">
    <h3>Current Task</h3>

    @if (ActiveTask is null)
    {
        <section class="workspace__section">
            <h4>Begin Engineering Work</h4>
            <p>No Current Task is active. Begin a task to capture the engineering intent for the work you are about to perform.</p>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p class="error">@ErrorMessage</p>
            }

            <div class="task-form">
                <label>
                    Title
                    <input @bind="Title" placeholder="Short task title" />
                </label>
                <label>
                    Description
                    <textarea @bind="Description" placeholder="What work is being performed?"></textarea>
                </label>
                <label>
                    Goal
                    <textarea @bind="Goal" placeholder="What outcome should this work produce?"></textarea>
                </label>
                <button class="btn" @onclick="StartTask">Begin Current Task</button>
            </div>
        </section>
    }
    else
    {
        <section class="workspace__section">
            <h4>@ActiveTask.Title</h4>
            <dl>
                <dt>Description</dt>
                <dd>@ActiveTask.Description</dd>
                <dt>Goal</dt>
                <dd>@ActiveTask.Goal</dd>
                <dt>Status</dt>
                <dd>@ActiveTask.Status</dd>
            </dl>
            <button class="btn" @onclick="CompleteTask">Complete Task</button>

            <section class="workspace__section workspace__section--brief">
                <h5>Engineering Brief</h5>
                <label>
                    Objective
                    <input value="@BriefObjective" @oninput="OnObjectiveChanged" placeholder="Short objective" />
                </label>
                <label>
                    Notes
                    <textarea @bind="BriefNotes" placeholder="Notes about the work"></textarea>
                </label>
                <label>
                    Implementation Thoughts
                    <textarea @bind="BriefImplementation" placeholder="Ideas for implementation"></textarea>
                </label>
                <div class="brief-actions">
                    <button class="btn" @onclick="SaveBrief">Save Brief</button>
                </div>
            </section>
        </section>
    }
</section>

@code {
    [Inject]
    private EngineeringDiscovery.Web.Services.CurrentTaskState CurrentTaskState { get; set; } = null!;

    private CurrentTask? ActiveTask => CurrentTaskState.ActiveTask;

    private string Title { get; set; } = string.Empty;

    private string Description { get; set; } = string.Empty;

    private string Goal { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }

    // Engineering Brief editor backing fields
    private string BriefObjective { get; set; } = string.Empty;
    private string BriefNotes { get; set; } = string.Empty;
    private string BriefImplementation { get; set; } = string.Empty;

    protected override void OnInitialized()
    {
        CurrentTaskState.OnChange += OnCurrentTaskChanged;
        if (ActiveTask is not null)
        {
            LoadBriefFromActiveTask();
        }
    }

    private void StartTask()
    {
        ErrorMessage = null;

        try
        {
            CurrentTaskState.StartTask(Title, Description, Goal);
            Title = string.Empty;
            Description = string.Empty;
            Goal = string.Empty;
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void CompleteTask()
    {
        CurrentTaskState.CompleteTask();
    }

    private void OnCurrentTaskChanged()
    {
        LoadBriefFromActiveTask();
        InvokeAsync(StateHasChanged);
    }

    private void LoadBriefFromActiveTask()
    {
        if (ActiveTask is null)
        {
            BriefObjective = string.Empty;
            BriefNotes = string.Empty;
            BriefImplementation = string.Empty;
            return;
        }

        BriefObjective = ActiveTask.Brief.Objective;
        BriefNotes = ActiveTask.Brief.Notes;
        BriefImplementation = ActiveTask.Brief.ImplementationThoughts;
    }

    private void OnObjectiveChanged(ChangeEventArgs e)
    {
        BriefObjective = e?.Value?.ToString() ?? string.Empty;
    }

    private void SaveBrief()
    {
        if (ActiveTask is null) return;

        CurrentTaskState.UpdateBrief(b =>
        {
            b.Objective = BriefObjective ?? string.Empty;
            b.Notes = BriefNotes ?? string.Empty;
            b.ImplementationThoughts = BriefImplementation ?? string.Empty;
            b.Touch();
        });
    }

    public void Dispose()
    {
        CurrentTaskState.OnChange -= OnCurrentTaskChanged;
    }
}
