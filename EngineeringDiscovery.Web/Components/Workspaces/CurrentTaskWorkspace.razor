@using EngineeringDiscovery.Core.Domain.CurrentTask
@namespace EngineeringDiscovery.Web.Components.Workspaces

<section class="workspace workspace--current-task">
    <h3>Current Task</h3>

    @if (ActiveTask is null)
    {
        <section class="workspace__section">
            <h4>Begin Engineering Work</h4>
            <p>No Current Task is active. Begin a task to capture the engineering intent for the work you are about to perform.</p>

            @if (!string.IsNullOrWhiteSpace(ErrorMessage))
            {
                <p class="error">@ErrorMessage</p>
            }

            <div class="task-form">
                <label>
                    Title
                    <input @bind="Title" placeholder="Short task title" />
                </label>
                <label>
                    Description
                    <textarea @bind="Description" placeholder="What work is being performed?"></textarea>
                </label>
                <label>
                    Goal
                    <textarea @bind="Goal" placeholder="What outcome should this work produce?"></textarea>
                </label>
                <button class="btn" @onclick="StartTask">Begin Current Task</button>
            </div>
        </section>
    }
    else
    {
        <section class="workspace__section">
            <h4>@ActiveTask.Title</h4>
            <dl>
                <dt>Description</dt>
                <dd>@ActiveTask.Description</dd>
                <dt>Goal</dt>
                <dd>@ActiveTask.Goal</dd>
                <dt>Status</dt>
                <dd>@ActiveTask.Status</dd>
            </dl>
            <button class="btn" @onclick="CompleteTask">Complete Task</button>

            <section class="workspace__section workspace__section--brief">
                <h5>Engineering Brief</h5>
                <label>
                    Objective
                    <input value="@BriefObjective" @oninput="OnObjectiveChanged" placeholder="Short objective" />
                </label>
                <label>
                    Notes
                    <textarea @bind="BriefNotes" placeholder="Notes about the work"></textarea>
                </label>
                <label>
                    Implementation Thoughts
                    <textarea @bind="BriefImplementation" placeholder="Ideas for implementation"></textarea>
                </label>
                <div class="brief-actions">
                    <button class="btn" @onclick="SaveBrief">Save Brief</button>
                </div>
                <div class="engineering-context">
                    <h6>Engineering Context</h6>
                    @if (ActiveTask?.Brief?.Context == null || ActiveTask.Brief.Context.IsEmpty())
                    {
                        <p>No engineering context selected.</p>
                    }
                    else
                    {
                        <ul>
                            @foreach (var pid in ActiveTask.Brief.Context.ProjectIds)
                            {
                                <li>@pid <button class="btn--small" @onclick="() => RemoveProject(pid)">Remove</button></li>
                            }
                            @foreach (var nid in ActiveTask.Brief.Context.NamespaceIds)
                            {
                                <li>@nid <button class="btn--small" @onclick="() => RemoveNamespace(nid)">Remove</button></li>
                            }
                            @foreach (var tid in ActiveTask.Brief.Context.TypeIds)
                            {
                                <li>@tid <button class="btn--small" @onclick="() => RemoveType(tid)">Remove</button></li>
                            }
                        </ul>
                    }
                    <div class="add-context">
                    <label>
                            Add Context (enter identifier):
                            <input @bind="ContextQuery" placeholder="Enter project / namespace / type id" />
                        </label>
                        <div class="context-kind">
                            <label>
                                Kind
                                <select @bind="SelectedContextKind">
                                    <option value="Project">Project</option>
                                    <option value="Namespace">Namespace</option>
                                    <option value="Type">Type</option>
                                </select>
                            </label>
                        </div>
                        <div class="context-results">
                            @if (ContextResults?.Any() == true)
                            {
                                <ul>
                                    @foreach (var r in ContextResults)
                                    {
                                        <li>@r <button class="btn--small" @onclick="() => AddContextItem(r)">Add</button></li>
                                    }
                                </ul>
                            }
                            <div class="context-add-inline">
                                <button class="btn" @onclick="() => AddContextItem(ContextQuery)">Add</button>
                            </div>
                        </div>
                    </div>
                </div>
            </section>
        </section>
    }
</section>

@code {
    [Inject]
    private EngineeringDiscovery.Web.Services.WorkspaceState WorkspaceState { get; set; } = null!;

    private CurrentTask? ActiveTask => WorkspaceState.ActiveWorkspace?.CurrentTask;

    private string Title { get; set; } = string.Empty;

    private string Description { get; set; } = string.Empty;

    private string Goal { get; set; } = string.Empty;

    private string? ErrorMessage { get; set; }

    // Engineering Brief editor backing fields
    private string BriefObjective { get; set; } = string.Empty;
    private string BriefNotes { get; set; } = string.Empty;
    private string BriefImplementation { get; set; } = string.Empty;
    private string ContextQuery { get; set; } = string.Empty;
    private string[] ContextResults { get; set; } = Array.Empty<string>();
    private string SelectedContextKind { get; set; } = "Type";

    protected override void OnInitialized()
    {
        WorkspaceState.OnChange += OnCurrentTaskChanged;
        if (ActiveTask is not null)
        {
            LoadBriefFromActiveTask();
        }
    }

    private async Task UpdateContextResults()
    {
        // V1: simple echo search (replace with InvestigationState lookup later)
        if (string.IsNullOrWhiteSpace(ContextQuery) || ActiveTask is null)
        {
            ContextResults = Array.Empty<string>();
            return;
        }

        ContextResults = new[] { ContextQuery };
    }

    private void AddContextItem(string id)
    {
        if (ActiveTask is null) return;

        WorkspaceState.UpdateBrief(b =>
        {
            switch (SelectedContextKind)
            {
                case "Project":
                    b.Context.AddProject(id);
                    break;
                case "Namespace":
                    b.Context.AddNamespace(id);
                    break;
                default:
                    b.Context.AddType(id);
                    break;
            }

            b.Touch();
        });
    }

    private void RemoveProject(string id)
    {
        if (ActiveTask is null) return;
        WorkspaceState.UpdateBrief(b => { b.Context.RemoveProject(id); b.Touch(); });
    }

    private void RemoveNamespace(string id)
    {
        if (ActiveTask is null) return;
        WorkspaceState.UpdateBrief(b => { b.Context.RemoveNamespace(id); b.Touch(); });
    }

    private void RemoveType(string id)
    {
        if (ActiveTask is null) return;
        WorkspaceState.UpdateBrief(b => { b.Context.RemoveType(id); b.Touch(); });
    }


    private void StartTask()
    {
        ErrorMessage = null;

        try
        {
            WorkspaceState.BeginTask(Title, Description, Goal);
            Title = string.Empty;
            Description = string.Empty;
            Goal = string.Empty;
        }
        catch (ArgumentException ex)
        {
            ErrorMessage = ex.Message;
        }
    }

    private void CompleteTask()
    {
        WorkspaceState.CompleteTask();
    }

    private void OnCurrentTaskChanged()
    {
        LoadBriefFromActiveTask();
        InvokeAsync(StateHasChanged);
    }

    private void LoadBriefFromActiveTask()
    {
        if (ActiveTask is null)
        {
            BriefObjective = string.Empty;
            BriefNotes = string.Empty;
            BriefImplementation = string.Empty;
            return;
        }

        BriefObjective = ActiveTask.Brief.Objective;
        BriefNotes = ActiveTask.Brief.Notes;
        BriefImplementation = ActiveTask.Brief.ImplementationThoughts;
    }

    private void OnObjectiveChanged(ChangeEventArgs e)
    {
        BriefObjective = e?.Value?.ToString() ?? string.Empty;
    }

    private void SaveBrief()
    {
        if (ActiveTask is null) return;

        // Update via WorkspaceState to keep Workspace as single source of truth
        WorkspaceState.UpdateBrief(b =>
        {
            b.Objective = BriefObjective ?? string.Empty;
            b.Notes = BriefNotes ?? string.Empty;
            b.ImplementationThoughts = BriefImplementation ?? string.Empty;
            b.Touch();
        });

        // WorkspaceState.UpdateBrief already persisted changes; nothing more to do here
    }

    public void Dispose()
    {
        WorkspaceState.OnChange -= OnCurrentTaskChanged;
    }
}
