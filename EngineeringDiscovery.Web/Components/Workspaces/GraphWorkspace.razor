@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Core.Models
@using Microsoft.AspNetCore.Components.Web
@namespace EngineeringDiscovery.Web.Components.Workspaces
@using System.Text.Json
@using System.Linq
@implements System.IAsyncDisposable

<section class="graph-workspace">
    <div class="graph-toolbar">
        <input placeholder="Search by qualified name" @bind="SearchText" />
        <button class="btn" @onclick="PerformSearch">Search</button>
        <button class="btn" @onclick="Fit">Fit</button>
        <button class="btn" @onclick="Reset">Reset</button>
        <button class="btn" @onclick="ZoomIn">Zoom +</button>
        <button class="btn" @onclick="ZoomOut">Zoom -</button>
        <label><input type="checkbox" @bind="FilterInheritance" /> Inheritance</label>
        <label><input type="checkbox" @bind="FilterImplementation" /> Implementation</label>
        <label><input type="checkbox" @bind="FilterDependency" /> Dependency</label>
    </div>

    <div class="graph-body">
        <div class="graph-container" @ondragstart:preventDefault>
            <div id="cy" style="width:100%; height:100%;"></div>
        </div>

        <aside class="graph-details">
            @if (SelectedNode is null)
            {
                <p class="muted">Select a node to see details.</p>
            }
            else
            {
                <div>
                    <h4>@SelectedNode</h4>
                    <p>Qualified Name: @SelectedNode</p>
                    <p>Dependencies: @GetDependenciesCount(SelectedNode)</p>
                    <p>Dependents: @GetDependentsCount(SelectedNode)</p>
                </div>
            }
        </aside>
    </div>
</section>

@code {
    [Parameter]
    public Investigation? Investigation { get; set; }

    [Inject]
    private EngineeringDiscovery.Web.Services.WorkspaceState WorkspaceState { get; set; } = null!;

    private DotNetObjectReference<GraphWorkspace>? dotNetRef;

    private record NodeInfo(string Id, string Label, double X, double Y);
    private record EdgeInfo(string Source, string Target, RelationshipType Type, double SourceX, double SourceY, double TargetX, double TargetY);

    private List<NodeInfo> Nodes = new();
    private List<EdgeInfo> Edges = new();

    private string? SelectedNode { get; set; }

    [Inject]
    private IJSRuntime JSRuntime { get; set; } = null!;
    [Inject]
    private NavigationManager NavigationManager { get; set; } = null!;

    private IJSObjectReference? _graphModule;
    private bool GraphNeedsUpdate { get; set; }

    private string SearchText { get; set; } = string.Empty;
    private bool FilterInheritance { get; set; } = true;
    private bool FilterImplementation { get; set; } = true;
    private bool FilterDependency { get; set; } = true;

    public GraphWorkspace()
    {
        Console.WriteLine("================GraphWorkspace()====================");
    }

    protected override void OnInitialized()
    {
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (Investigation is null)
        {
            Investigation = WorkspaceState.ActiveWorkspace?.Investigation;
        }
        BuildGraphFromInvestigation();
        GraphNeedsUpdate = true;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            dotNetRef = DotNetObjectReference.Create(this);
            var elements = BuildCytoscapeElements();
            var viewState = WorkspaceState.GraphViewState;
            // Import module using relative path so it resolves under the app base href
            var modulePath = NavigationManager.BaseUri.TrimEnd('/') + "/js/graphInterop.js";
            _graphModule = await JSRuntime.InvokeAsync<IJSObjectReference>("import", modulePath);
            try
            {
                await _graphModule.InvokeVoidAsync("init", "cy", elements, dotNetRef, viewState);
            }
            catch (JSException jsEx)
            {
                Console.Error.WriteLine($"Graph init JSException: {jsEx.Message}");
                WorkspaceState.GraphViewState ??= new EngineeringDiscovery.Web.Services.GraphViewState();
                WorkspaceState.GraphViewState.SelectedNode = null;
            }
            await _graphModule.InvokeVoidAsync("setFilters", new { Inheritance = FilterInheritance, Implementation = FilterImplementation, Dependency = FilterDependency });
            GraphNeedsUpdate = false;
        }
        else if (GraphNeedsUpdate && _graphModule != null)
        {
            var elements = BuildCytoscapeElements();
            await _graphModule.InvokeVoidAsync("update", elements);
            await _graphModule.InvokeVoidAsync("setFilters", new { Inheritance = FilterInheritance, Implementation = FilterImplementation, Dependency = FilterDependency });
            GraphNeedsUpdate = false;
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (dotNetRef != null) dotNetRef.Dispose();
        if (_graphModule != null) await _graphModule.InvokeVoidAsync("destroy");
    }

    [JSInvokable]
    public void OnGraphInitError(string message)
    {
        Console.Error.WriteLine($"Graph init error: {message}");
    }

    [JSInvokable]
    public void OnGraphInitialized(int nodes, int edges, int width, int height)
    {
    }

    private object BuildCytoscapeElements()
    {
        var elems = new List<object>();
        if (Investigation?.RelationshipGraph is null) return elems;

        var qnames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        // Collect all relationship types we render into the graph view
        foreach (var r in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Inheritance)) { qnames.Add(r.Source); qnames.Add(r.Target); }
        foreach (var r in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Dependency)) { qnames.Add(r.Source); qnames.Add(r.Target); }
        foreach (var r in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Implementation)) { qnames.Add(r.Source); qnames.Add(r.Target); }

        foreach (var q in qnames)
        {
            elems.Add(new { data = new { id = q, label = ShortLabel(q), kind = "Class" } });
        }

        // Add edges for each supported relationship type
        foreach (var rel in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Inheritance))
        {
            elems.Add(new { data = new { id = $"e_{rel.Source}_{rel.Target}", source = rel.Source, target = rel.Target, type = "Inheritance" } });
        }
        foreach (var rel in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Dependency))
        {
            elems.Add(new { data = new { id = $"e_{rel.Source}_{rel.Target}_dep", source = rel.Source, target = rel.Target, type = "Dependency" } });
        }
        foreach (var rel in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Implementation))
        {
            elems.Add(new { data = new { id = $"e_{rel.Source}_{rel.Target}_impl", source = rel.Source, target = rel.Target, type = "Implementation" } });
        }

        return elems;
    }

    private void BuildGraphFromInvestigation()
    {
        Nodes.Clear();
        Edges.Clear();
        if (Investigation?.RelationshipGraph is null) return;

        // Create nodes from RelationshipGraph outgoing keys
        var qnames = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var src in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Inheritance))
        {
            qnames.Add(src.Source);
            qnames.Add(src.Target);
        }

        foreach (var src in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Dependency))
        {
            qnames.Add(src.Source);
            qnames.Add(src.Target);
        }

        // Simple placement: grid layout (kept for compatibility)
        var cols = Math.Max(1, (int)Math.Ceiling(Math.Sqrt(qnames.Count)));
        int i = 0;
        foreach (var q in qnames)
        {
            var row = i / cols;
            var col = i % cols;
            var x = 80 + col * 120;
            var y = 80 + row * 80;
            Nodes.Add(new NodeInfo(q, ShortLabel(q), x, y));
            i++;
        }

        // Build edges with coordinates (kept for compatibility in case of fallback)
        foreach (var rel in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Inheritance))
        {
            var s = Nodes.FirstOrDefault(n => string.Equals(n.Id, rel.Source, StringComparison.OrdinalIgnoreCase));
            var t = Nodes.FirstOrDefault(n => string.Equals(n.Id, rel.Target, StringComparison.OrdinalIgnoreCase));
            if (s != null && t != null)
            {
                Edges.Add(new EdgeInfo(s.Id, t.Id, RelationshipType.Inheritance, s.X, s.Y, t.X, t.Y));
            }
        }
        foreach (var rel in Investigation.RelationshipGraph.GetRelationships(RelationshipType.Dependency))
        {
            var s = Nodes.FirstOrDefault(n => string.Equals(n.Id, rel.Source, StringComparison.OrdinalIgnoreCase));
            var t = Nodes.FirstOrDefault(n => string.Equals(n.Id, rel.Target, StringComparison.OrdinalIgnoreCase));
            if (s != null && t != null)
            {
                Edges.Add(new EdgeInfo(s.Id, t.Id, RelationshipType.Dependency, s.X, s.Y, t.X, t.Y));
            }
        }
    }

    private string ShortLabel(string qn)
    {
        if (string.IsNullOrWhiteSpace(qn)) return qn;
        var parts = qn.Split('.', '+');
        return parts.Length > 0 ? parts.Last() : qn;
    }

    private int GetDependenciesCount(string qn) => Investigation?.RelationshipGraph?.GetOutgoingRelationships(qn).Count(r => r.Type == RelationshipType.Dependency) ?? 0;
    private int GetDependentsCount(string qn) => Investigation?.RelationshipGraph?.GetIncomingRelationships(qn).Count(r => r.Type == RelationshipType.Dependency) ?? 0;

    [JSInvokable]
    public void OnNodeSelected(string id)
    {
        SelectedNode = id;
        if (WorkspaceState.GraphViewState is null) WorkspaceState.GraphViewState = new EngineeringDiscovery.Web.Services.GraphViewState();
        WorkspaceState.GraphViewState.SelectedNode = id;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnViewStateChanged(JsonElement state)
    {
        if (WorkspaceState.GraphViewState is null) WorkspaceState.GraphViewState = new EngineeringDiscovery.Web.Services.GraphViewState();
        try
        {
            if (state.TryGetProperty("zoom", out var z)) WorkspaceState.GraphViewState.Zoom = z.GetDouble();
            if (state.TryGetProperty("pan", out var p) && p.ValueKind == JsonValueKind.Object) WorkspaceState.GraphViewState.Pan = p;
            if (state.TryGetProperty("selected", out var s) && s.ValueKind == JsonValueKind.String) WorkspaceState.GraphViewState.SelectedNode = s.GetString();
        }
        catch { }
    }

    private async Task PerformSearch()
    {
        if (string.IsNullOrWhiteSpace(SearchText) || _graphModule == null) return;
        await _graphModule.InvokeVoidAsync("selectNode", SearchText.Trim());
        SelectedNode = SearchText.Trim();
        if (WorkspaceState.GraphViewState is null) WorkspaceState.GraphViewState = new EngineeringDiscovery.Web.Services.GraphViewState();
        WorkspaceState.GraphViewState.SelectedNode = SelectedNode;
        StateHasChanged();
    }

    private async Task Fit()
    {
        if (_graphModule != null) await _graphModule.InvokeVoidAsync("fit");
    }

    private async Task Reset()
    {
        if (_graphModule != null) await _graphModule.InvokeVoidAsync("reset");
    }

    private async Task ZoomIn()
    {
        if (_graphModule != null) await _graphModule.InvokeVoidAsync("zoomIn");
    }

    private async Task ZoomOut()
    {
        if (_graphModule != null) await _graphModule.InvokeVoidAsync("zoomOut");
    }
}
