@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Core.Domain
@namespace EngineeringDiscovery.Web.Components.Workspaces

@using System
@using EngineeringDiscovery.Core.Domain
@using EngInv = EngineeringDiscovery.Core.Domain.Investigation

@code {
    [Parameter]
    public EngInv.Investigation? Investigation { get; set; }

    private string? ErrorMessage { get; set; }

    private string NewFindingDescription { get; set; } = string.Empty;

    // Fail fast: Investigation is required. Do not silently create placeholder data.
    protected override void OnParametersSet()
    {
        if (Investigation is null)
        {
            throw new InvalidOperationException("InvestigationWorkspace requires an Investigation parameter to be provided by the parent component.");
        }
    }

    private EngInv.Investigation Sample => Investigation!;

    private void HandleException(InvalidOperationException ex) => ErrorMessage = ex.Message;

    private void ClearError() => ErrorMessage = null;

    private void Start()
    {
        try
        {
            Sample.Start();
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void Complete()
    {
        try
        {
            Sample.Complete();
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void Reopen()
    {
        try
        {
            Sample.Reopen();
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void SetStage(Action<EngineeringStageStatus> setter, ChangeEventArgs e)
    {
        try
        {
            var value = Enum.Parse<EngineeringStageStatus>(e?.Value?.ToString() ?? EngineeringStageStatus.NotStarted.ToString());
            setter(value);
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }

    private void AddFinding()
    {
        try
        {
            var desc = NewFindingDescription?.Trim();
            if (string.IsNullOrEmpty(desc)) return;

            var f = new EngInv.Finding(Guid.NewGuid(), desc);
            Sample.AddFinding(f);
            NewFindingDescription = string.Empty;
            ClearError();
        }
        catch (InvalidOperationException ex)
        {
            HandleException(ex);
        }
    }
}

<article class="investigation-card">
    <h4>@Sample.Target — @Sample.Id.ToString().Substring(0, 8)</h4>
    <p class="muted">Status: <strong>@Sample.Status</strong> — Created: @Sample.StartedAt?.ToString("yyyy-MM-dd HH:mm") ?? "n/a"</p>

    <div class="investigation-summary">
        <p><strong>Goal:</strong> @Sample.Goal</p>
        <p><strong>Owner:</strong> @Sample.Owner</p>
        <p><strong>Target:</strong> @Sample.Target</p>
    </div>

    <h5>Lifecycle</h5>
    <div class="lifecycle-actions">
        <button class="btn" @onclick="Start">Start Investigation</button>
        <button class="btn" @onclick="Complete">Complete Investigation</button>
        <button class="btn" @onclick="Reopen">Reopen Investigation</button>
    </div>

    @if (!string.IsNullOrEmpty(ErrorMessage))
    {
        <div class="error">@ErrorMessage</div>
    }

    <h5>Engineering Progress</h5>
    <table class="progress-table">
        <tbody>
            <tr>
                <td>Architecture</td>
                <td>
                    <select value="@Sample.ArchitectureStatus" @onchange="(e) => SetStage(s => Sample.SetArchitectureStatus(s), e)">
                        <option value="NotStarted">Not Started</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Complete">Complete</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Planning</td>
                <td>
                    <select value="@Sample.PlanningStatus" @onchange="(e) => SetStage(s => Sample.SetPlanningStatus(s), e)">
                        <option value="NotStarted">Not Started</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Complete">Complete</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Development</td>
                <td>
                    <select value="@Sample.DevelopmentStatus" @onchange="(e) => SetStage(s => Sample.SetDevelopmentStatus(s), e)">
                        <option value="NotStarted">Not Started</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Complete">Complete</option>
                    </select>
                </td>
            </tr>
            <tr>
                <td>Verification</td>
                <td>
                    <select value="@Sample.VerificationStatus" @onchange="(e) => SetStage(s => Sample.SetVerificationStatus(s), e)">
                        <option value="NotStarted">Not Started</option>
                        <option value="InProgress">In Progress</option>
                        <option value="Complete">Complete</option>
                    </select>
                </td>
            </tr>
        </tbody>
    </table>

    <h5>Findings</h5>
    <ul>
        @foreach (var f in Sample.Findings)
        {
            <li>@f.Description</li>
        }
    </ul>

    <div class="add-finding">
        <input @bind="NewFindingDescription" placeholder="New finding description" />
        <button class="btn" @onclick="AddFinding">Add Finding</button>
    </div>
</article>
