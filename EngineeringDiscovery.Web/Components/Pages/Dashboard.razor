@page "/dashboard"
@using Microsoft.AspNetCore.WebUtilities

<PageTitle>Engineering Discovery</PageTitle>

@using EngineeringDiscovery.Core.Domain.Models
@using EngineeringDiscovery.Core.Domain.Investigation

<div class="dashboard-grid">
    <aside class="left-pane">
        <RoleNavigation @bind-ActiveRole="SelectedRole" />
    </aside>

    <main class="main-pane">
        <div class="main-content">
            <h1>Engineering Discovery</h1>

            <SectionHeader Title="Repository Summary" Subtitle="High level repository facts" />
            <div class="cards-row">
                <RepositoryCard Investigation="SampleInvestigation" />
                <StatusCard Statuses="PipelineStatuses" />
            </div>

            <SectionHeader Title="Current Investigation" Subtitle="Investigation metadata and status" />
            <div class="cards-row">
                <div style="flex:2;min-width:0;display:flex;justify-content:center;align-items:flex-start">
                    <div style="width:100%">
                        <WorkspaceHost Role="SelectedRole" />
                    </div>
                </div>
                <div style="flex:1;min-width:240px">
                    <ActionCard Title="Next Recommended Action">
                        <p>
                            Roadmap generation will appear here. EngineeringDiscovery will recommend the next engineering
                            milestone after repository analysis.
                        </p>
                    </ActionCard>
                </div>
            </div>
        </div>
    </main>
</div>

@code {
    [Inject]
    private NavigationManager Nav { get; set; } = null!;

    private EngineeringRole SelectedRole { get; set; } = EngineeringRole.CurrentTask;
    private string? ViewModelProject { get; set; } = "(none)";

    [Inject]
    private EngineeringDiscovery.Core.Services.WorkspaceState WorkspaceState { get; set; } = null!;

    private EngineeringDiscovery.Core.Domain.Investigation.Investigation? SampleInvestigation => WorkspaceState.ActiveWorkspace?.Investigation;

    protected override void OnInitialized()
    {
        WorkspaceState.OnChange += OnWorkspaceChanged;

        // Read query string to allow navigation like /dashboard?role=Architect
        try
        {
            var uri = new Uri(Nav.Uri);
            var query = QueryHelpers.ParseQuery(uri.Query);
            if (query.TryGetValue("role", out var roleValues))
            {
                var roleString = roleValues.FirstOrDefault();
                if (!string.IsNullOrWhiteSpace(roleString) && Enum.TryParse<EngineeringRole>(roleString, true, out var parsed))
                {
                    SelectedRole = parsed;
                }
            }
        }
        catch
        {
            // conservative: if query parsing fails, keep default SelectedRole
        }
    }

    private void OnWorkspaceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WorkspaceState.OnChange -= OnWorkspaceChanged;
    }

    private List<(string Name, bool IsComplete)> PipelineStatuses => new()
    {
        ("Repository Loaded", !string.IsNullOrWhiteSpace(WorkspaceState.ActiveWorkspace?.RepositoryPath)),
        ("Engineering Model Built", WorkspaceState.ActiveWorkspace?.Investigation != null),
        ("Relationship Graph Built", WorkspaceState.ActiveWorkspace?.Investigation?.RelationshipGraph != null),
        ("Repository Metrics Calculated", WorkspaceState.ActiveWorkspace?.Investigation?.RepositoryMetrics != null),
        ("Engineering Rules Evaluated", WorkspaceState.ActiveWorkspace?.Investigation?.Artifacts?.Count > 0),
        ("Roadmap Generated", false)
    };
}
