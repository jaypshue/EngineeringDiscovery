@namespace EngineeringDiscovery.Web.Components.Pages
@using EngineeringDiscovery.Core.Domain.Investigation
@using System.Linq
@using EngineeringDiscovery.Web.Services
@using EngineeringDiscovery.Web.Components.Conversation
@using EngineeringDiscovery.Web.Components.Shared
@inject SessionStartupService Startup
@inject EngineeringDiscovery.Web.Services.WorkspaceStateService WorkspaceState
@inject EngineeringDiscovery.Core.Services.WorkspaceState CoreWorkspaceState

<div class="conversation-experience-shell">
    <DesktopEngineeringWorkspace @ref="_desktopWorkspace"
                                  Investigation="@ActiveInvestigation"
                                  ShowUnderstanding="@ShowUnderstanding"
                                  OnConversationStart="HandleConversationStart" />
</div>

@code {
    private DesktopEngineeringWorkspace? _desktopWorkspace;

    private Investigation? ActiveInvestigation =>
        CoreWorkspaceState.ActiveWorkspace?.Investigation
        ?? CoreWorkspaceState.ActiveWorkspace?.ImportedRepositories?
            .FirstOrDefault(repository => repository.Investigation is not null)?.Investigation;

    private bool ShowUnderstanding =>
        CoreWorkspaceState.ActiveWorkspace?.ActiveProject is not null
        && ActiveInvestigation is not null;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            if (Startup.ConsumeShouldFocus())
            {
                var placeholder = Startup.ConsumePlaceholder();
                if (_desktopWorkspace != null)
                {
                    if (!string.IsNullOrEmpty(placeholder)) await _desktopWorkspace.SetComposerPlaceholderAsync(placeholder);
                    await Task.Delay(50);
                    await _desktopWorkspace.FocusComposerAsync();
                }
            }
            WorkspaceState.StateChanged += StateHasChanged;
            CoreWorkspaceState.OnChange += OnCoreStateChanged;
        }
    }

    private void OnCoreStateChanged() => InvokeAsync(StateHasChanged);

    private async Task HandleConversationStart(string prompt)
    {
        if (_desktopWorkspace != null)
        {
            await _desktopWorkspace.FocusComposerAsync();
        }
    }
}
