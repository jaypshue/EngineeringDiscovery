@page "/graph"
@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Web.Components.Workspaces

<PageTitle>Engineering Graph</PageTitle>

<h2>Engineering Graph</h2>

@inject EngineeringDiscovery.Web.Services.WorkspaceState WorkspaceState

<GraphWorkspace Investigation="SampleInvestigation" />

@code {
    private EngineeringDiscovery.Core.Domain.Investigation.Investigation? SampleInvestigation => WorkspaceState.ActiveWorkspace?.Investigation;

    protected override void OnInitialized()
    {
        WorkspaceState.OnChange += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        WorkspaceState.OnChange -= OnWorkspaceChanged;
    }
}
