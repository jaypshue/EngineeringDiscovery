@page "/graph"
@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Web.Components.Workspaces

<PageTitle>Engineering Graph</PageTitle>

<h2>Engineering Graph</h2>

<GraphWorkspace Investigation="SampleInvestigation" />

@inject EngineeringDiscovery.Web.Services.InvestigationState InvestigationState

@code {
    private Investigation? SampleInvestigation => InvestigationState.Investigation;

    protected override void OnInitialized()
    {
        InvestigationState.OnChange += OnInvestigationChanged;
    }

    private void OnInvestigationChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        InvestigationState.OnChange -= OnInvestigationChanged;
    }
}
