@page "/app"
@layout Layout.AppLayout

@using EngineeringDiscovery.Web.Components.Pages

<PageTitle>EngineOS</PageTitle>

@inject EngineeringDiscovery.Core.Services.WorkspaceState WorkspaceState
@inject EngineeringDiscovery.Web.Services.SessionStartupService Startup
@inject NavigationManager Nav

@code {
    private bool IsBuildStart { get; set; }
    private bool ShowNewProjectConversation { get; set; }

    protected override void OnInitialized()
    {
        WorkspaceState.OnChange += WorkspaceState_OnChange;

        try
        {
            var uri = Nav.ToAbsoluteUri(Nav.Uri);
            var q = System.Web.HttpUtility.ParseQueryString(uri.Query);
            IsBuildStart = string.Equals(q.Get("start"), "build", StringComparison.OrdinalIgnoreCase);
            if (IsBuildStart)
            {
                Startup.MarkForFocus("What would you like to build today?");
            }
        }
        catch
        {
            IsBuildStart = false;
        }
    }
}

@{
    var activeWorkspace = WorkspaceState.ActiveWorkspace;
    var hasActiveProject = activeWorkspace?.ActiveProject is not null;
    var hasLegacyWorkspace = activeWorkspace is not null && !hasActiveProject && !activeWorkspace.IsEmpty();
    var hasNoWorkspace = activeWorkspace is null || activeWorkspace.IsEmpty();

    // Only an active project owns the workspace conversation. A legacy workspace without
    // an active project returns to the launcher, as does an empty/no workspace. The explicit
    // New Project action remains the only exception so existing new-project behavior is kept.
    var showConversation = ShowNewProjectConversation ||
        (hasActiveProject && !hasLegacyWorkspace && !hasNoWorkspace);
}

@if (showConversation)
{
    <ConversationExperience />
}
else
{
    <ProjectLauncher OnNewProjectSelected="HandleNewProjectSelected" />
}

@code {
    private void HandleNewProjectSelected()
    {
        ShowNewProjectConversation = true;
        Startup.MarkForFocus("What would you like to build?");
        StateHasChanged();
    }

    private void WorkspaceState_OnChange() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        try { WorkspaceState.OnChange -= WorkspaceState_OnChange; } catch { }
    }
}
