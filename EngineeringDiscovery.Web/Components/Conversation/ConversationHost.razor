@using Microsoft.JSInterop
@using EngineeringDiscovery.Core.Services
@using EngineeringDiscovery.Core.Domain.EngineeringModel
@using EngineeringDiscovery.Core.Observations
@using System.Linq
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IEngineeringPartner Partner
@inject IObservationService ObservationService
@inject EngineeringDiscovery.Web.Services.WorkspaceStateService WorkspaceState
@inject EngineeringDiscovery.Web.Services.WorkContractService ContractService

<style>
    @@keyframes ed-pulse {
        0% { transform: scale(1); opacity: 0.9; }
        50% { transform: scale(1.4); opacity: 0.5; }
        100% { transform: scale(1); opacity: 0.9; }
    }
</style>

<div class="conversation-host">
    <div class="messages" @ref="_messagesRef">
        @foreach (var m in Messages)
        {
            <div class="message" style="margin-bottom:8px">
                <div class="speaker" style="font-weight:600;font-size:0.72rem;color:var(--accent);text-transform:uppercase;letter-spacing:0.03em;margin-bottom:2px">@m.Speaker</div>
                <div class="text" style="margin-top:2px;line-height:1.42;color:var(--text)">@((MarkupString)RenderMarkdown(m.Text))</div>
            </div>
        }
    </div>

    <div class="composer">
        @if (PendingImage is not null)
        {
            <div class="pending-attachment">
                <img src="@PendingImage.DataUrl" alt="Pasted image preview" />
                <div class="pending-attachment-details">
                    <span>@PendingImage.FileName</span>
                    <button type="button" class="btn btn-outline btn-sm" @onclick="ClearPendingImage">Remove</button>
                </div>
            </div>
        }

        <div class="composer-input-row">
            <textarea @ref="_composerRef" rows="2" style="flex:1;padding:6px 10px;border-radius:6px;border:1px solid rgba(255,255,255,0.08);background:rgba(255,255,255,0.02);color:var(--text);resize:none;height:2.5rem;line-height:1.42;font-size:0.88rem;font-family:inherit" value="@Draft" @oninput="HandleDraftInput" placeholder="@(_composerPlaceholder)" @onkeydown="HandleKeyDown"></textarea>
            <div style="display:flex;flex-direction:column;align-items:flex-end;gap:6px">
                <button class="btn btn-primary" @onclick="SendAsync" disabled="@(IsSending || string.IsNullOrWhiteSpace(Draft))">Send</button>
                @if (IsSending)
                {
                    <div style="font-size:0.8rem;color:var(--muted);display:flex;align-items:center;gap:6px">
                        <span style="width:8px;height:8px;border-radius:50%;background:var(--muted);display:inline-block;animation: ed-pulse 1s infinite linear"></span>
                        <span>EngineOS is thinking…</span>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@code {
    private List<(string Speaker, string Text)> Messages { get; } = new();
    private string Draft { get; set; } = string.Empty;
    private bool IsSending { get; set; }
    private Guid? SessionId { get; set; }
    private string CurrentRecommendation { get; set; } = string.Empty;
    private string CurrentCoordination { get; set; } = string.Empty;
    private ElementReference _composerRef;
    private ElementReference _messagesRef;
    private IJSObjectReference? _conversationInterop;
    private bool _scrollToBottomAfterRender;
    private DotNetObjectReference<ConversationHost>? _dotNetRef;
    private PendingImageAttachment? PendingImage { get; set; }
    private string _composerPlaceholder = "Describe what you're working on... (Enter to send, Shift+Enter for newline)";
    private bool IsProposalPending { get; set; }
    private string ProposedChangePreview { get; set; } = string.Empty;

    private sealed record PendingImageAttachment(string DataUrl, string MimeType, string FileName, long Size);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _conversationInterop = await JS.InvokeAsync<IJSObjectReference>("import", "./js/conversationInterop.js");
                _dotNetRef = DotNetObjectReference.Create(this);
                await _conversationInterop.InvokeVoidAsync("attachPasteHandler", _composerRef, _dotNetRef);
            }
            catch
            {
                // Clipboard preview and scroll anchoring are progressive enhancements; text composition remains available if interop fails.
            }
        }

        if (_scrollToBottomAfterRender && _conversationInterop is not null)
        {
            _scrollToBottomAfterRender = false;
            try
            {
                await _conversationInterop.InvokeVoidAsync("scrollToBottom", _messagesRef);
            }
            catch
            {
                // The conversation remains usable if the scroll element is unavailable during teardown.
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var model = await Partner.StartSessionAsync(string.Empty);
            SessionId = model?.Id;
            if (model?.Conversation != null && model.Conversation.Any())
            {
                foreach (var e in model.Conversation)
                {
                    Messages.Add((e.Speaker ?? "EngineOS", e.Message ?? string.Empty));
                }

    // No explicit input handler; rely on Blazor @bind to update Draft on input events.
            }
            else
            {
                Messages.Add(("EngineOS", "Good morning. What are we working on today?"));
            }

            // RepoAttached ingestion is performed by the import workflow prior to navigation so the
            // ConversationHost does not re-ingest the same observation on render. ConversationHost
            // assumes WorkspaceState and EngineeringModel have been prepared by the host.

            // Load any existing recommendation from EngineeringModel
            await LoadRecommendationAsync();
        }
        catch
        {
            Messages.Add(("EngineOS", "The Engineering Partner is currently unavailable. You can still type messages and they will be sent when the service returns."));
        }

        _scrollToBottomAfterRender = true;
    }



    // Public methods for parent to control composer focus and placeholder
    public async Task FocusComposerAsync()
    {
        try
        {
            await _composerRef.FocusAsync();
        }
        catch { }
    }

    public Task SetComposerPlaceholderAsync(string placeholder)
    {
        _composerPlaceholder = placeholder ?? string.Empty;
        StateHasChanged();
        return Task.CompletedTask;
    }

    public Task SetDraftAsync(string text)
    {
        Draft = text ?? string.Empty;
        StateHasChanged();
        return Task.CompletedTask;
    }

    [JSInvokable("HandlePastedImage")]
    public Task HandlePastedImageAsync(string dataUrl, string mimeType, string fileName, long size)
    {
        if (string.IsNullOrWhiteSpace(dataUrl)
            || string.IsNullOrWhiteSpace(mimeType)
            || !mimeType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)
            || size <= 0
            || size > 4_000_000)
        {
            return Task.CompletedTask;
        }

        PendingImage = new PendingImageAttachment(
            dataUrl,
            mimeType,
            string.IsNullOrWhiteSpace(fileName) ? "pasted-image" : fileName,
            size);

        return InvokeAsync(StateHasChanged);
    }

    private void ClearPendingImage() => PendingImage = null;

    private void HandleDraftInput(Microsoft.AspNetCore.Components.ChangeEventArgs e)
    {
        Draft = e.Value?.ToString() ?? string.Empty;
    }

    private async Task AppendMessageAsync(string speaker, string text)
    {
        _scrollToBottomAfterRender = await IsNearBottomAsync();
        Messages.Add((speaker, text));
    }

    private async Task<bool> IsNearBottomAsync()
    {
        if (_conversationInterop is null)
        {
            return true;
        }

        try
        {
            return await _conversationInterop.InvokeAsync<bool>("isNearBottom", _messagesRef, 64);
        }
        catch
        {
            return true;
        }
    }

    private async Task SendAsync()
    {
        var text = (Draft ?? string.Empty).Trim();
        if (string.IsNullOrEmpty(text)) return;

        await AppendMessageAsync("You", text);
        Draft = string.Empty;
        PendingImage = null;
        IsSending = true;

        try
        {
            if (SessionId == null || SessionId == Guid.Empty)
            {
                var model = await Partner.StartSessionAsync(string.Empty);
                SessionId = model?.Id;
            }

            // Create a UserMessage observation and ingest it through the ObservationEngine
            var obs = new Observation { Type = "UserMessage", Source = "User", SessionId = SessionId, PayloadJson = System.Text.Json.JsonSerializer.Serialize(new { text = text }) };
            await ObservationService.IngestAsync(obs);

            var reply = await Partner.SendMessageAsync(SessionId ?? Guid.Empty, text);
            if (!string.IsNullOrWhiteSpace(reply))
            {
                await AppendMessageAsync("EngineOS", reply);
            }

            // Refresh recommendation display from updated model
            await LoadRecommendationAsync();
        }
        catch (Exception ex)
        {
            await AppendMessageAsync("EngineOS", "Failed to send message: " + ex.Message);
        }
        finally
        {
            IsSending = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private Task HandleKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        // Enter sends, Shift+Enter creates a newline
        if (e.Key == "Enter" && !e.ShiftKey)
        {
            _ = SendAsync();
        }
        return Task.CompletedTask;
    }

    private async Task LoadRecommendationAsync()
    {
        CurrentRecommendation = string.Empty;
        CurrentCoordination = string.Empty;
        if (SessionId == null || SessionId == Guid.Empty) return;
        try
        {
            var model = await Partner.GetWorkingMemoryAsync(SessionId ?? Guid.Empty);
            if (model != null && model.KnownFacts != null)
            {
                var rec = model.KnownFacts.LastOrDefault(f => string.Equals(f.Key, "LastRecommendation", StringComparison.OrdinalIgnoreCase));
                if (rec != null) CurrentRecommendation = rec.Value ?? string.Empty;
                var coord = model.KnownFacts.LastOrDefault(f => string.Equals(f.Key, "Coordination", StringComparison.OrdinalIgnoreCase));
                if (coord != null) CurrentCoordination = coord.Value ?? string.Empty;
            }
        }
        catch { }
    }

    private async Task AcknowledgeRecommendationAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentRecommendation) || SessionId == null) return;
        try
        {
            var decision = new { summary = CurrentRecommendation, timestamp = DateTime.UtcNow };
            var obs = new Observation
            {
                Type = "DecisionAccepted",
                Source = "User",
                SessionId = SessionId,
                PayloadJson = System.Text.Json.JsonSerializer.Serialize(decision)
            };
            await ObservationService.IngestAsync(obs);

            // Reflect acknowledgement in the conversation
            await AppendMessageAsync("You", "Acknowledged recommendation: " + CurrentRecommendation);
            await LoadRecommendationAsync();
        }
        catch { }
    }

    // Request EngineOS to propose a revision to the active Work Contract based on the current recommendation or
    // a user prompt. The proposed change is returned as a preview and must be explicitly accepted by the user
    // to update the WorkContractService.CurrentContract.
    private async Task ProposeContractEditAsync()
    {
        if (SessionId == null || string.IsNullOrWhiteSpace(CurrentRecommendation)) return;
        try
        {
            // Ask partner for a proposed update to the contract. We include the active contract summary via WorkspaceState.
            var prompt = new { action = "ProposeWorkContractEdit", recommendation = CurrentRecommendation, contractTitle = WorkspaceState.ActiveWorkContractTitle, contractStatus = WorkspaceState.ActiveWorkContractStatus };
            var obs = new Observation { Type = "ProposeContractEditRequest", Source = "User", SessionId = SessionId, PayloadJson = System.Text.Json.JsonSerializer.Serialize(prompt) };
            await ObservationService.IngestAsync(obs);

            // Partner should produce a structured suggestion into working memory; reload recommendation area
            await LoadRecommendationAsync();

            // For simplicity reuse CurrentRecommendation as the suggested contract change preview text.
            // Display the preview in the conversation messages and add Accept/Reject actions as follow-ups.
            ProposedChangePreview = CurrentRecommendation;
            IsProposalPending = true;
            await AppendMessageAsync("EngineOS", "Proposed Contract Edit (preview available).");
            await InvokeAsync(StateHasChanged);
        }
        catch { }
    }

    private async Task AcceptProposal()
    {
        // Apply proposal: for this implementation we translate CurrentRecommendation into a simple Title/Objectives update.
        if (string.IsNullOrWhiteSpace(CurrentRecommendation) || ContractService.CurrentContract == null) return;

        ContractService.ApplyProposal(c =>
        {
            // Keep it minimal: if Title is empty, set it; otherwise append to Objective
            if (string.IsNullOrWhiteSpace(c.Title)) c.Title = CurrentRecommendation;
            else c.Objective = (c.Objective + "\n" + CurrentRecommendation).Trim();
        }, "EngineOS");

        await AppendMessageAsync("You", "Accepted proposal and updated Work Contract.");
        IsProposalPending = false;
        ProposedChangePreview = string.Empty;
        // Refresh workspace recommendation area and UI
        _ = LoadRecommendationAsync();
        await InvokeAsync(StateHasChanged);
    }

    private async Task RejectProposal()
    {
        await AppendMessageAsync("You", "Rejected the proposed contract edit.");
        await InvokeAsync(StateHasChanged);
    }

    private async Task GenerateWorkContractAsync()
    {
        if (string.IsNullOrWhiteSpace(CurrentRecommendation) || ContractService == null) return;

        // Build a minimal WorkContract draft from the recommendation
        var draft = new EngineeringDiscovery.Web.Models.WorkContract
        {
            Title = CurrentRecommendation.Length > 120 ? CurrentRecommendation.Substring(0, 120) : CurrentRecommendation,
            Objective = CurrentRecommendation,
            RepositoryName = WorkspaceState.ActiveRepositoryName,
            RepositoryPath = WorkspaceState.ActiveRepositoryPath
        };

        ContractService.CreateDraft(draft);
        // Mark the draft as proposed by EngineOS so WorkContractEditor reflects proposer intent.
        ContractService.ApplyProposal(c => { }, "EngineOS");

        // Add a message to the conversation to indicate the action
        await AppendMessageAsync("You", "Generated Work Contract from recommendation");
        // Refresh recommendation area (it may be cleared by ingestion)
        await LoadRecommendationAsync();
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_conversationInterop is not null)
            {
                try { await _conversationInterop.InvokeVoidAsync("detachPasteHandler", _composerRef); } catch { }
            }
        }
        finally
        {
            _dotNetRef?.Dispose();
            if (_conversationInterop is not null)
            {
                try { await _conversationInterop.DisposeAsync(); } catch { }
            }
        }
    }

    private static string RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return string.Empty;

        var html = System.Net.WebUtility.HtmlEncode(text);

        // Code blocks
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"```\s*([\s\S]*?)```",
            m => "<pre style=\"background:rgba(255,255,255,0.03);padding:8px;border-radius:4px;overflow-x:auto;font-size:0.78rem;line-height:1.35;margin:6px 0\"><code>" + m.Groups[1].Value.Trim() + "</code></pre>");

        // Inline code
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"`([^`]+)`",
            "<code style=\"background:rgba(255,255,255,0.06);padding:0 3px;border-radius:3px;font-size:0.84rem\">$1</code>");

        // Headings
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"^###\s+(.+)$", "<h4 style=\"margin:7px 0 3px 0;font-size:0.86rem\">$1</h4>",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"^##\s+(.+)$", "<h3 style=\"margin:8px 0 4px 0;font-size:0.96rem\">$1</h3>",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"^#\s+(.+)$", "<h2 style=\"margin:10px 0 4px 0;font-size:1.06rem\">$1</h2>",
            System.Text.RegularExpressions.RegexOptions.Multiline);

        // Bold
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\*\*(.+?)\*\*", "<strong>$1</strong>");

        // Italic
        html = System.Text.RegularExpressions.Regex.Replace(html, @"(?<!\*)\*(?!\*)(.+?)(?<!\*)\*(?!\*)", "<em>$1</em>");

        // List items
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"^-\s+(.+)$", "<li style=\"margin:1px 0\">$1</li>",
            System.Text.RegularExpressions.RegexOptions.Multiline);
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"((?:<li[^>]*>.*?</li>\s*)+)",
            m => "<ul style=\"margin:3px 0;padding-left:16px\">" + m.Value + "</ul>");

        // Horizontal rules
        html = System.Text.RegularExpressions.Regex.Replace(html,
            @"^---+$", "<hr style=\"margin:8px 0;border:0;border-top:1px solid rgba(255,255,255,0.08)\">",
            System.Text.RegularExpressions.RegexOptions.Multiline);

        // Paragraphs
        html = html.Replace("\r\n", "\n");
        html = System.Text.RegularExpressions.Regex.Replace(html, @"\n\n+", "</p><p style=\"margin:4px 0\">");
        html = html.Replace("\n", "<br>");
        html = "<p style=\"margin:0\">" + html + "</p>";
        html = html.Replace("<p style=\"margin:0\"></p>", "");
        html = html.Replace("<p style=\"margin:8px 0\"></p>", "");

        return html;
    }
}
