@namespace EngineeringDiscovery.Web.Components.Workspace
@using Microsoft.AspNetCore.Components

@{
    var hasRepository = !string.IsNullOrWhiteSpace(ActiveRepositoryName);
    var discoveredTechnologies = GetDiscoveredTechnologies();
    var hasTechnologies = discoveredTechnologies != null && discoveredTechnologies.Count > 0;
    var hasStatus = !string.IsNullOrWhiteSpace(Status) && (Status != "Ready" || Investigation != null);
    var showCard = hasRepository || hasTechnologies || hasStatus;
}

@if (showCard)
{
    <div class="engineering-context-card" style="padding:12px;border-radius:8px;background:var(--surface-1);box-shadow:0 1px 4px rgba(0,0,0,0.04);max-width:980px;margin:0 auto;display:flex;gap:12px;align-items:center">
        <div style="display:flex;justify-content:space-between;align-items:center">
            @if (hasRepository)
            {
                <div>
                    <div style="font-size:0.85rem;color:var(--muted)">Repository</div>
                    <div style="font-weight:700;font-size:1rem">@ActiveRepositoryName</div>
                    @if (!string.IsNullOrWhiteSpace(ActiveRepositoryPath))
                    {
                        <div style="font-size:0.75rem;color:var(--muted);margin-top:4px">@ActiveRepositoryPath</div>
                    }
                </div>
            }

            @if (hasStatus)
            {
                <div style="text-align:right">
                    <div style="font-size:0.8rem;color:var(--muted)">Discovery</div>
                    <div style="font-weight:700">@Status</div>
                </div>
            }
        </div>

        @if (hasTechnologies)
        {
            <div style="display:flex;gap:20px;margin-top:12px;align-items:center">
                <div style="flex:1">
                    <div style="font-size:0.8rem;color:var(--muted)">Technologies</div>
                    <div style="margin-top:6px">@string.Join(", ", discoveredTechnologies)</div>
                </div>
            </div>
        }
    </div>
}

@code {
    [Parameter]
    public EngineeringDiscovery.Core.Domain.Investigation.Investigation? Investigation { get; set; }

    [Parameter]
    public string ActiveRepositoryName { get; set; } = string.Empty;

    [Parameter]
    public string ActiveRepositoryPath { get; set; } = string.Empty;

    [Parameter]
    public string CurrentGoalTitle { get; set; } = string.Empty;

    [Parameter]
    public string CurrentStoryTitle { get; set; } = string.Empty;

    [Parameter]
    public string Status { get; set; } = "Ready";

    // Work Contract summary (read-only presentation values provided by WorkspaceStateService)
    [Parameter]
    public string ActiveWorkContractTitle { get; set; } = string.Empty;

    [Parameter]
    public string ActiveWorkContractStatus { get; set; } = string.Empty;

    [Parameter]
    public bool ActiveWorkContractHumanReady { get; set; }

    [Parameter]
    public bool ActiveWorkContractEngineOSReady { get; set; }

    [Parameter]
    public string ActiveWorkContractLastUpdatedBy { get; set; } = string.Empty;

    [Parameter]
    public string ActiveNextRecommendedAction { get; set; } = string.Empty;

    [Parameter]
    public string ActiveNextRecommendedActionDetail { get; set; } = string.Empty;

    [Parameter]
    public EventCallback DefineGoal { get; set; }

    [Parameter]
    public EventCallback CreateStory { get; set; }

    [Parameter]
    public EventCallback ContinueSession { get; set; }

    private async Task OnDefineGoal() => await DefineGoal.InvokeAsync(null);
    private async Task OnCreateStory() => await CreateStory.InvokeAsync(null);
    private async Task OnContinueSession() => await ContinueSession.InvokeAsync(null);

    private void CreateWorkContract()
    {
        // Fire an event through ContinueSession to let the page handle creation (ConversationExperience will call ContractService.CreateEmptyDraft)
        _ = ContinueSession.InvokeAsync(null);
    }

    private string GetTechnologySummary()
    {
        if (Investigation == null)
        {
            return string.Empty;
        }

        // ProjectObservation.Project is a project identifier; we don't invent a technology list here.
        if (Investigation.ProjectObservation != null && !string.IsNullOrEmpty(Investigation.ProjectObservation.Project))
        {
            return Investigation.ProjectObservation.Project;
        }

        return string.Empty;
    }

    private System.Collections.Generic.List<string>? GetDiscoveredTechnologies()
    {
        if (Investigation == null) return null;

        // Technology discovery in this repo is represented by Findings that mention known frameworks or package references.
        // We conservatively parse Findings for simple technology hints (no invention). If none found, return null.
        var list = new System.Collections.Generic.List<string>();
        try
        {
            if (Investigation.Findings != null)
            {
                foreach (var f in Investigation.Findings)
                {
                    var desc = f.Description ?? string.Empty;
                    if (desc.IndexOf("EntityFrameworkCore", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("EntityFrameworkCore")) list.Add("EntityFrameworkCore");
                    if (desc.IndexOf("Serilog", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("Serilog")) list.Add("Serilog");
                    if (desc.IndexOf("SignalR", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("SignalR")) list.Add("SignalR");
                    if (desc.IndexOf("xunit", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("xUnit")) list.Add("xUnit");
                    if (desc.IndexOf("nunit", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("NUnit")) list.Add("NUnit");
                    if (desc.IndexOf("MediatR", System.StringComparison.OrdinalIgnoreCase) >= 0 && !list.Contains("MediatR")) list.Add("MediatR");
                }
            }
        }
        catch
        {
            // conservative: if parsing fails, treat as no technologies discovered
            return null;
        }

        return list.Count > 0 ? list : null;
    }
}
