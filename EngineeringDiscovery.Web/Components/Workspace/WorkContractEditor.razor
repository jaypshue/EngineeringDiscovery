@namespace EngineeringDiscovery.Web.Components.Workspace
@using EngineeringDiscovery.Web.Models
@using EngineeringDiscovery.Web.Services
@inject WorkContractService ContractService

<div class="work-contract-editor" style="background:var(--surface-1);padding:12px;border-radius:6px;">
    @if (ContractService.CurrentContract is null)
    {
        <div>No Implementation Package in this session.</div>
    }
    else
    {
        var contract = ContractService.CurrentContract;
        var isEmpty = contract.IsEmpty() && string.IsNullOrWhiteSpace(contract.DocumentText);

        <div style="display:flex;flex-direction:column;gap:8px;">
            <div style="display:flex;justify-content:space-between;align-items:center">
                <div style="font-weight:700;font-size:1.05rem">Implementation Package</div>
                <div style="display:flex;gap:8px">
                    @* Keep human readiness toggle but remove any explicit "Request Draft" action. The package is a live projection. *@
                    <button class="btn btn-sm" @onclick="ToggleHumanReady">Human Ready: @(contract.HumanReady ? "Yes" : "No")</button>
                </div>
            </div>

            <div style="margin-top:8px;font-size:0.95rem;color:var(--muted);">This Implementation Package is a live, read-only projection of the current Staging Area. It reflects EngineOS's current understanding and the resolved package dimensions below. The package updates automatically as the Staging Area evolves.</div>

            <div style="display:flex;gap:16px;margin-top:8px;flex-wrap:wrap">
                <div style="flex:1;min-width:280px">
                    <div style="font-weight:600;margin-bottom:6px">Package Dimensions</div>
                    @* Seven dimensions with resolved status *@
                    @foreach (var d in GetDimensionStatuses(contract))
                    {
                        <div style="display:flex;justify-content:space-between;padding:6px 4px;border-bottom:1px dashed rgba(255,255,255,0.02)">
                            <div>@d.Name</div>
                            <div style="color:var(--muted)">@d.Status</div>
                        </div>
                    }
                </div>

                <div style="flex:2;min-width:320px">
                    <div style="font-weight:600;margin-bottom:6px">Package Content (read-only)</div>
                    <div style="margin-top:8px">
                        <textarea readonly style="width:100%;min-height:240px;padding:8px;border-radius:6px;border:1px solid rgba(255,255,255,0.06);font-family:monospace">@GetDocumentText(contract)</textarea>
                    </div>
                </div>
            </div>

            <div style="display:flex;gap:8px;align-items:center">
                <div>Status: <strong>@contract.Status</strong></div>
                <div>EngineOS Ready: <strong>@(contract.EngineOSReady ? "Yes" : "No")</strong></div>
                @if (!string.IsNullOrEmpty(contract.LastUpdatedBy))
                {
                    <div>Last Updated By: <strong>@contract.LastUpdatedBy</strong></div>
                }
            </div>
        </div>
    }
</div>

@code {
    protected override void OnInitialized()
    {
        ContractService.ContractChanged += OnContractChanged;
        // Initialize document text from the current contract
        if (ContractService.CurrentContract != null)
        {
            DocumentText = string.IsNullOrWhiteSpace(ContractService.CurrentContract.DocumentText) ? ContractService.CurrentContract.ToDocumentText() : ContractService.CurrentContract.DocumentText;
        }
    }

    private void OnContractChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ContractService.ContractChanged -= OnContractChanged;
    }

    private void OnTitleInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.Title = text);
    }

    private void OnObjectiveInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.Objective = text);
    }

    private void OnAcceptanceInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.AcceptanceCriteria = text);
    }

    private void OnOutOfScopeInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.OutOfScope = text);
    }

    private void OnImplementationInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.ImplementationPlan = text);
    }

    private void OnVerificationInput(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        ContractService.UpdateField(c => c.VerificationRequirements = text);
    }

    private void ToggleHumanReady()
    {
        var cur = ContractService.CurrentContract;
        if (cur == null) return;
        ContractService.SetHumanReady(!cur.HumanReady);
    }

    private void SimulateEngineReady()
    {
        var cur = ContractService.CurrentContract;
        if (cur == null) return;
        ContractService.SetEngineOSReady(!cur.EngineOSReady);
    }

    private string DocumentText { get; set; } = string.Empty;

    private void OnDocumentEdited(ChangeEventArgs e)
    {
        var text = e?.Value?.ToString() ?? string.Empty;
        // Update the living document text on the contract and clear readiness
        ContractService.UpdateField(c => c.DocumentText = text);
    }

    private async Task RequestDraft()
    {
        // Removed user-triggered Request Draft per UX-111. The Implementation Package is a live projection
        // and EngineOS will populate proposals automatically via conversation-driven flows.
        await Task.CompletedTask;
    }

    private IEnumerable<(string Name, string Status)> GetDimensionStatuses(EngineeringDiscovery.Web.Models.WorkContract contract)
    {
        // Map the seven dimensions to basic heuristics using existing contract fields.
        yield return ("Intent", string.IsNullOrWhiteSpace(contract.Title) ? "Unresolved" : "Resolved");
        yield return ("Scope", string.IsNullOrWhiteSpace(contract.Objective) ? "Unresolved" : "Resolved");
        yield return ("Target", string.IsNullOrWhiteSpace(contract.RepositoryName) ? "Unresolved" : "Resolved");
        yield return ("Required Changes", string.IsNullOrWhiteSpace(contract.ImplementationPlan) ? "Unresolved" : "Resolved");
        yield return ("Exclusions", string.IsNullOrWhiteSpace(contract.OutOfScope) ? "Unresolved" : "Resolved");
        yield return ("Verification", string.IsNullOrWhiteSpace(contract.VerificationRequirements) ? "Unresolved" : "Resolved");
        // Unresolved dimension aggregates any remaining empty fields
        var unresolved = (string.IsNullOrWhiteSpace(contract.Title)
            || string.IsNullOrWhiteSpace(contract.Objective)
            || string.IsNullOrWhiteSpace(contract.ImplementationPlan)
            || string.IsNullOrWhiteSpace(contract.VerificationRequirements)) ? "Has Unresolved Items" : "All Resolved";
        yield return ("Unresolved", unresolved);
    }

    private string GetDocumentText(EngineeringDiscovery.Web.Models.WorkContract contract)
    {
        if (!string.IsNullOrWhiteSpace(contract.DocumentText)) return contract.DocumentText;
        return contract.ToDocumentText();
    }
}
