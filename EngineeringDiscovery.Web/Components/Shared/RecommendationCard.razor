@namespace EngineeringDiscovery.Web.Components.Shared
@using Microsoft.AspNetCore.Components
@using EngineeringDiscovery.Core.Domain.Investigation
@using EngineeringDiscovery.Core.Models

<div class="recommendation-card">
    <div class="rec-summary">
        @if (Investigation == null)
        {
            <h3>No recommendations available yet.</h3>
            <p class="muted">Investigation not available.</p>
        }
        else
        {
            <!-- Do not infer recommendations from artifacts. Show explicit recommendation only when provided via Investigation.Artifacts with a Recommendation-like type (none defined); otherwise show no recommendations. -->
            <h3>No recommendations available yet.</h3>
            <p class="muted">The Investigation contains @((Investigation.Artifacts?.Count) ?? 0) artifact(s). Open details for investigation-backed artifacts and evidence.</p>
        }
    </div>

    @* Actions removed per UX-104: RecommendationCard is read-only and document-like *@

    <div class="rec-details">
        <a href="#" @onclick="ToggleWhy">Why?</a>
        @if (ShowWhy)
        {
            if (Investigation != null && (Investigation.Findings?.Count ?? 0) > 0)
            {
                <div class="why">
                    <ul>
                        @foreach (var f in Investigation.Findings)
                        {
                            <li>@f.Type.ToString(): @f.Description</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="why">No investigation evidence available for a recommendation.</div>
            }
        }

        <a href="#" @onclick="ToggleFiles">Investigation Artifacts</a>
        @if (ShowFiles)
        {
            if (Investigation != null && (Investigation.Artifacts?.Count ?? 0) > 0)
            {
                <div class="files">
                    <ul>
                        @foreach (var a in Investigation.Artifacts)
                        {
                            <li>@a.Type.ToString(): <strong>@a.Title</strong> — @a.Description</li>
                        }
                    </ul>
                </div>
            }
            else
            {
                <div class="files">No artifacts available in the Investigation.</div>
            }
        }

        <a href="#" @onclick="ToggleImpl">Implementation</a>
        @if (ShowImpl)
        {
            <div class="impl">
                <p>If implementation notes are present as Investigation artifacts they will appear here; otherwise this information is not available from the Investigation.</p>
            </div>
        }
    </div>
</div>

@code {
    [Parameter]
    public Investigation? Investigation { get; set; }

    [Parameter]
    public string? Title { get; set; }

    [Parameter]
    public string? Rationale { get; set; }

    private bool ShowWhy { get; set; }
    private bool ShowFiles { get; set; }
    private bool ShowImpl { get; set; }

    private string WhyPlaceholder => "High-level reasoning and brief evidence summary.";
    private string FilesPlaceholder => "List of affected files (placeholder).";
    private string ImplPlaceholder => "Implementation notes / patch placeholder.";

    // RecommendationCard is read-only per UX-104; action callbacks removed.

    private void ToggleWhy()
    {
        ShowWhy = !ShowWhy; ShowFiles = false; ShowImpl = false;
    }

    private void ToggleFiles()
    {
        ShowFiles = !ShowFiles; ShowWhy = false; ShowImpl = false;
    }

    private void ToggleImpl()
    {
        ShowImpl = !ShowImpl; ShowWhy = false; ShowFiles = false;
    }
}
