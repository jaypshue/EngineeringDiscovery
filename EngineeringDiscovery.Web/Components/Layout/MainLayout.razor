@inherits LayoutComponentBase
@using EngineeringDiscovery.Core.Services
@inject WorkspaceState WorkspaceState
@implements IDisposable

<div class="ed-shell">
    <header class="ed-header">
        <div class="ed-header-left">
            <div class="ed-logo">ED</div>
            <div class="ed-title">EngineeringDiscovery</div>
        </div>
        <div class="ed-header-right">
            <div class="ed-user">Workspace</div>
        </div>
    </header>

    <div class="ed-body">
        @if (!WorkspaceState.HasWorkspace)
        {
            <nav class="ed-nav">
                <NavigationMenu />
            </nav>
        }

        <main class="ed-workspace">
            @Body
        </main>
    </div>

    <footer class="ed-statusbar">
        <div class="status-left">Status: Ready</div>
        <div class="status-right">Mode: Dark • Resolution: Responsive</div>
    </footer>

    <div id="blazor-error-ui" data-nosnippet>
        An unhandled error has occurred.
        <a href="." class="reload">Reload</a>
        <span class="dismiss">🗙</span>
    </div>
</div>

@code {
    protected override void OnInitialized()
    {
        base.OnInitialized();
        WorkspaceState.OnChange += OnWorkspaceChanged;
    }

    private void OnWorkspaceChanged() => InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        try { WorkspaceState.OnChange -= OnWorkspaceChanged; } catch { }
    }
}
