@namespace EngineeringDiscovery.Web.Components.Layout
@inherits LayoutComponentBase
@inject EngineeringDiscovery.Core.Services.WorkspaceState WorkspaceState

<div class="ed-shell">
    <header class="ed-header">
        <div class="ed-header-left">
            <div class="ed-logo">E</div>
            <div class="ed-title">EngineOS</div>
        </div>
        <div class="ed-header-right" style="display:flex;align-items:center;gap:16px">
            @if (WorkspaceState.ActiveWorkspace?.Investigation != null)
            {
                <a href="/graph" class="app-nav-link">Architecture</a>
                <a href="/repository" class="app-nav-link">Repository</a>
            }
            @if (WorkspaceState.ActiveWorkspace?.ActiveProject != null)
            {
                <span class="app-project-badge">@WorkspaceState.ActiveWorkspace.ActiveProject.Name</span>
            }
        </div>
    </header>

    <div class="ed-body app-body">
        <main class="ed-workspace app-workspace">
            <div class="app-content-area">
                @Body
            </div>
        </main>
    </div>

    <footer class="ed-statusbar">
        <div class="status-left">
            @if (WorkspaceState.ActiveWorkspace?.ActiveProject != null)
            {
                <span>@WorkspaceState.ActiveWorkspace.ActiveProject.Name</span>
            }
            else
            {
                <span>No active project</span>
            }
        </div>
        <div class="status-right">EngineOS</div>
    </footer>
</div>

<style>
    .app-body {
        flex-direction: column;
        min-height: 0;
    }
    .app-workspace {
        min-height: 0;
        overflow: hidden;
        padding: 0;
        display: flex;
        flex-direction: column;
        align-items: stretch;
    }
    .app-content-area {
        max-width: none;
        width: 100%;
        height: 100%;
        min-height: 0;
        margin: 0 auto;
        padding: 20px 24px;
        box-sizing: border-box;
        flex: 1;
        display: flex;
        flex-direction: column;
        overflow: hidden;
    }
    .app-nav-link {
        color: var(--muted);
        text-decoration: none;
        font-size: 0.85rem;
        font-weight: 500;
        padding: 4px 10px;
        border-radius: 4px;
        transition: color 0.15s, background 0.15s;
    }
    .app-nav-link:hover {
        color: var(--accent);
        background: rgba(96, 165, 250, 0.06);
    }
    .app-project-badge {
        font-size: 0.8rem;
        color: var(--accent);
        background: rgba(96, 165, 250, 0.08);
        padding: 3px 10px;
        border-radius: 12px;
        font-weight: 600;
        letter-spacing: -0.01em;
    }
</style>
