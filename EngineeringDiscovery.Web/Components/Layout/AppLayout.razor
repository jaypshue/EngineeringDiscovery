@namespace EngineeringDiscovery.Web.Components.Layout
@inherits LayoutComponentBase

<div class="app-shell">
    @inject EngineeringDiscovery.Web.Services.WorkspaceStateService WorkspaceState
    <header class="app-header" style="display:flex;justify-content:space-between;align-items:center;padding:12px 20px">
        <div style="display:flex;gap:12px;align-items:center">
            <div class="app-logo">EngineOS</div>
            <div style="font-size:0.9rem;color:var(--muted);">Conversation-first engineering partner</div>
        </div>
        <div style="display:flex;gap:12px;align-items:center">
            <div class="app-actions">
                <a href="/app">Workspace</a>
                <a href="/">Public Site</a>
            </div>
        </div>
    </header>

    <div class="repository-context" style="padding:8px 0;border-top:1px solid var(--border);border-bottom:1px solid var(--border);background:var(--surface)">
        @inject EngineeringDiscovery.Core.Services.WorkspaceState CoreWorkspaceState
        <div style="display:flex;flex-direction:column;gap:8px;margin:0 24px">
            <div style="font-size:0.9rem;color:var(--muted);">Imported Repositories</div>

            @if (CoreWorkspaceState.ImportedRepositories != null && CoreWorkspaceState.ImportedRepositories.Count > 0)
            {
                <div style="display:flex;flex-direction:column;gap:6px">
                    @foreach (var repo in CoreWorkspaceState.ImportedRepositories)
                    {
                        <div class="repo-item" style="display:flex;align-items:center;gap:12px;justify-content:space-between;padding:6px;border-radius:4px">
                            <div class="repo-context" style="min-width:0;flex:1">
                                <div style="font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@repo.RepositoryPath</div>
                                @if (repo.LastBuiltUtc is not null)
                                {
                                    <div style="font-size:0.75rem;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis">@repo.LastBuiltUtc?.ToLocalTime().ToString("f")</div>
                                }
                            </div>
                            <div style="padding-left:12px;font-size:0.85rem;color:var(--muted)">
                                <a href="/repository#refresh" style="color:var(--link);text-decoration:underline">Refresh</a>
                            </div>
                        </div>
                    }
                </div>
            }
            else
            {
                <div style="color:var(--muted)">No repository has been imported.</div>
            }

            <div style="display:flex;justify-content:flex-end">
                <a href="/repository" style="padding:0 6px;font-size:0.9rem;color:var(--link);text-decoration:underline">Add repository</a>
            </div>
        </div>
    </div>

    <main class="app-body" style="padding:16px 0">
        <div style="margin:0 24px">
            @Body
        </div>
    </main>

    <footer class="app-footer">
        <div style="margin:0 24px">EngineOS — Conversation-first engineering partner</div>
    </footer>
</div>
