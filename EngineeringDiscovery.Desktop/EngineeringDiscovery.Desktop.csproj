<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net10.0-windows10.0.19041.0</TargetFrameworks>
    <UseMaui>true</UseMaui>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationTitle>EngineeringDiscovery.Desktop</ApplicationTitle>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\EngineeringDiscovery.Web\EngineeringDiscovery.Web.csproj" />
    <ProjectReference Include="..\EngineeringDiscovery.Core\EngineeringDiscovery.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Maui" Version="8.0.80" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebView.Maui" Version="8.0.0" />
    <ItemGroup>
      <Content Include="wwwroot\**\*" CopyToOutputDirectory="Always" />
    </ItemGroup>
  </ItemGroup>

</Project>
