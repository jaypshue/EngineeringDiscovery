<UserControl x:Class="EngineeringDiscovery.Wpf.Baseline.Views.WelcomeView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="400" Width="600">
    <Grid Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="24" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#FFF" BorderBrush="#DDD" BorderThickness="1" Padding="16" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Corporate Engineering" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Work inside an existing software organization. Import or open a repository to recover engineering understanding." TextWrapping="Wrap" />
                <Button Content="Open Existing Repository" Name="CorporateButton" Margin="0,12,0,0" Width="220" Height="40" />
            </StackPanel>
        </Border>

        <Border Grid.Column="2" Background="#FFF" BorderBrush="#DDD" BorderThickness="1" Padding="16" CornerRadius="6">
            <StackPanel>
                <TextBlock Text="Free Range Engineering" FontSize="20" FontWeight="Bold" Margin="0,0,0,8" />
                <TextBlock Text="Start with an idea and build something new. Discover the product before writing code." TextWrapping="Wrap" />
                <Button Content="Start New Product" Name="FreeRangeButton" Margin="0,12,0,0" Width="220" Height="40" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
