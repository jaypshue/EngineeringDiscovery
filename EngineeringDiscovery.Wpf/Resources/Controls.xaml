<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="Button">
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="Margin" Value="4" />
    </Style>

    <!-- Accent send button style -->
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentBrush}" />
        <Setter Property="Foreground" Value="{StaticResource AccentForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
        <Setter Property="Width" Value="80" />
        <Setter Property="Height" Value="36" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Padding" Value="8,4" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Opacity" Value="0.95" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{StaticResource InputBorderBrush}" />
                <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Padding" Value="6,4" />
    </Style>
</ResourceDictionary>