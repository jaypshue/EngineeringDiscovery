<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Core tokens -->
    <Color x:Key="BackgroundColor">#FFF6F8FA</Color>
    <Color x:Key="SurfaceColor">#FFFFFFFF</Color>
    <Color x:Key="PanelBackgroundColor">#FFF9FAFB</Color>
    <Color x:Key="BorderColor">#FFE6E9EE</Color>
    <Color x:Key="CardBorderColor">#FFDDDFE3</Color>

    <Color x:Key="PrimaryTextColor">#FF111827</Color>
    <Color x:Key="SecondaryTextColor">#FF6B7280</Color>
    <Color x:Key="MutedTextColor">#FF9CA3AF</Color>

    <Color x:Key="AccentColor">#FF0078D4</Color>
    <Color x:Key="AccentForegroundColor">#FFFFFFFF</Color>

    <!-- Conversation-specific tokens -->
    <Color x:Key="EngineOSBackgroundColor">#FFEEF8FF</Color>
    <Color x:Key="UserBackgroundColor">#FFF7FEF6</Color>

    <!-- Input tokens -->
    <Color x:Key="InputBorderColor">#FFD1D5DB</Color>
    <Color x:Key="InputBackgroundColor">#FFFFFFFF</Color>

    <SolidColorBrush x:Key="BackgroundBrush" Color="{StaticResource BackgroundColor}" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="{StaticResource SurfaceColor}" />
    <SolidColorBrush x:Key="PanelBackgroundBrush" Color="{StaticResource PanelBackgroundColor}" />
    <SolidColorBrush x:Key="BorderBrushColor" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="{StaticResource CardBorderColor}" />

    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryTextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedTextColor}" />

    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="{StaticResource AccentForegroundColor}" />

    <SolidColorBrush x:Key="EngineOSBackgroundBrush" Color="{StaticResource EngineOSBackgroundColor}" />
    <SolidColorBrush x:Key="UserBackgroundBrush" Color="{StaticResource UserBackgroundColor}" />

    <SolidColorBrush x:Key="InputBorderBrush" Color="{StaticResource InputBorderColor}" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="{StaticResource InputBackgroundColor}" />
    <SolidColorBrush x:Key="PlaceholderBrush" Color="{StaticResource MutedTextColor}" />
</ResourceDictionary>