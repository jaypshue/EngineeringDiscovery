<Application x:Class="EngineeringDiscovery.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EngineeringDiscovery.Wpf"
             xmlns:vm="clr-namespace:EngineeringDiscovery.Wpf.ViewModels">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- EngineOS dark theme -->
                <ResourceDictionary Source="Resources/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WelcomeTemplate" DataType="{x:Type vm:MainWindowViewModel}">
                <local:WelcomeWorkspace />
            </DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>