<Application x:Class="EngineeringDiscovery.Wpf.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:EngineeringDiscovery.Wpf"
             xmlns:vm="clr-namespace:EngineeringDiscovery.Wpf.ViewModels">
    <Application.Resources>
        <ResourceDictionary xmlns:converters="clr-namespace:EngineeringDiscovery.Wpf.Converters">
            <ResourceDictionary.MergedDictionaries>
                <!-- EngineOS palette (base tokens) -->
                <ResourceDictionary Source="Resources/Colors.xaml" />
                <!-- Controls/styles consume the final brushes -->
                <ResourceDictionary Source="Resources/Controls.xaml" />
                <!-- Theme overlay (dark theme) applied last to ensure Welcome dark surfaces and text contrast are authoritative -->
                <ResourceDictionary Source="Resources/DarkTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <DataTemplate x:Key="WelcomeTemplate" DataType="{x:Type vm:MainWindowViewModel}">
                <local:WelcomeWorkspace />
            </DataTemplate>
            <!-- Converters -->
            <converters:NeedsReviewVisibilityConverter x:Key="NeedsReviewVisibilityConverter" />
            <converters:RecommendedActionConverter x:Key="RecommendedActionConverter" />
        </ResourceDictionary>
    </Application.Resources>
</Application>