<Window x:Class="EngineeringDiscovery.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Engineering Discovery" Height="800" Width="1200" Background="{StaticResource BackgroundBrush}">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Investigation" Command="{Binding NewInvestigationCommand}" />
                <MenuItem Header="Open Repository" Command="{Binding OpenRepositoryCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="View" />
            <MenuItem Header="Help" />
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Command="{Binding NewInvestigationCommand}" />
            <Button Content="Open" Command="{Binding OpenRepositoryCommand}" />
        </ToolBar>

        <ContentControl x:Name="HostContent" />
    </DockPanel>
</Window>