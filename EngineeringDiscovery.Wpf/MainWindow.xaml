<Window x:Class="EngineeringDiscovery.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Engineering Discovery" Height="800" Width="1200">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="File">
                <MenuItem Header="New Investigation" Command="{Binding NewInvestigationCommand}" />
                <MenuItem Header="Open Repository" Command="{Binding OpenRepositoryCommand}" />
                <Separator />
                <MenuItem Header="Exit" Command="{Binding ExitCommand}" />
            </MenuItem>
            <MenuItem Header="View" />
            <MenuItem Header="Help" />
        </Menu>
        <ToolBar DockPanel.Dock="Top">
            <Button Content="New" Command="{Binding NewInvestigationCommand}" />
            <Button Content="Open" Command="{Binding OpenRepositoryCommand}" />
        </ToolBar>

        <Grid>
            <Grid.ColumnDefinitions>
            <ColumnDefinition Width="250" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="5" />
                <ColumnDefinition Width="300" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="200" />
            </Grid.RowDefinitions>

            <Border Grid.Column="0" Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <!-- Left pane reserved for Repository Explorer (placeholder) -->
                <TextBlock Text="Repository Explorer" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <GridSplitter Grid.Column="1" Grid.Row="0" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" />

            <Border x:Name="CenterBorder" Grid.Column="2" Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <!-- Primary content area: bind to ActivityViewModel projection -->
                <StackPanel Margin="12" DataContext="{Binding Activity}">
                    <TextBlock FontSize="48" Foreground="Red" Text="HELLO ENGINEOS" />
                    <TextBlock Text="Current Activity" FontWeight="Bold" FontSize="16" Margin="0,0,0,8" />
                    <TextBlock Text="{Binding Type}" FontSize="14" FontWeight="SemiBold" />
                    <TextBlock Text="Status" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Status}" />
                    <TextBlock Text="Intent" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding Intent}" TextWrapping="Wrap" />
                    <Separator Margin="0,12" />
                    <TextBlock Text="Current Observation" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CurrentObservationDescription}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Source: " FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentObservationSource}" />
                        <TextBlock Text="  Confidence: " FontWeight="Bold" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding CurrentObservationConfidence}" />
                    </StackPanel>
                    <Separator Margin="0,12" />
                    <TextBlock Text="Current Hypothesis" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CurrentHypothesisDescription}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Status: " FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentHypothesisStatus}" />
                        <TextBlock Text="  Confidence: " FontWeight="Bold" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding CurrentHypothesisConfidence}" />
                    </StackPanel>
                    <Separator Margin="0,12" />
                    <TextBlock Text="Current Evidence Request" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="Target" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CurrentEvidenceRequestTarget}" TextWrapping="Wrap" />
                    <TextBlock Text="Reason" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CurrentEvidenceRequestReason}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Expected Information Gain: " FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentEvidenceRequestExpectedInformationGain}" />
                        <TextBlock Text="  Expected Confidence Increase: " FontWeight="Bold" Margin="12,0,0,0" />
                        <TextBlock Text="{Binding CurrentEvidenceRequestExpectedConfidenceIncrease}" />
                    </StackPanel>
                    <Separator Margin="0,12" />
                    <TextBlock Text="Evidence" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="Collected Evidence Count:" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="{Binding CurrentEvidenceCount}" />
                    <Separator Margin="0,12" />
                    <TextBlock Text="Recovered Understanding" FontWeight="Bold" Margin="0,8,0,0" />
                    <TextBlock Text="{Binding CurrentRecoveredUnderstandingStatement}" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                        <TextBlock Text="Confidence: " FontWeight="Bold" />
                        <TextBlock Text="{Binding CurrentRecoveredUnderstandingConfidence}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <GridSplitter Grid.Column="3" Grid.Row="0" Width="5" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" ShowsPreview="True" />

            <Border Grid.Column="4" Grid.Row="0" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <TextBlock Text="Inspector" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <Border Grid.Column="0" Grid.ColumnSpan="3" Grid.Row="1" BorderBrush="Gray" BorderThickness="1" Margin="4">
                <TextBlock Text="Output Window" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>

            <!--<StatusBar DockPanel.Dock="Bottom" Grid.Column="0" Grid.ColumnSpan="3">
                <TextBlock Text="Ready" />
            </StatusBar>-->
        </Grid>
    </DockPanel>
</Window>