<UserControl x:Class="EngineeringDiscovery.Wpf.Views.KnowledgeGraphPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <Grid>
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="600">
            <TextBlock Text="Knowledge Graph" FontSize="26" FontWeight="Bold" TextAlignment="Center" Margin="0,0,0,12" />
            <TextBlock Text="The understanding graph will appear here." TextAlignment="Center" Margin="0,0,0,6" TextWrapping="Wrap" />
            <TextBlock Text="No repository or product has been analyzed yet." TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
