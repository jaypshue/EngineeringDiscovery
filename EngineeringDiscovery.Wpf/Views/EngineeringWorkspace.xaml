<UserControl x:Class="EngineeringDiscovery.Wpf.Views.EngineeringWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:EngineeringDiscovery.Wpf.Views"
             Background="{StaticResource BackgroundBrush}"
             Foreground="{StaticResource PrimaryTextBrush}">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="ConversationBusyVisibility" />
        <BooleanToVisibilityConverter x:Key="PendingConfirmationVisibility" />

        <Style x:Key="ConversationMessageBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
            <Setter Property="BorderThickness" Value="1" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Speaker}" Value="You">
                    <Setter Property="Background" Value="{StaticResource BackgroundBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Speaker}" Value="EngineOS">
                    <Setter Property="Background" Value="{StaticResource CardBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource BorderBrushColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" MinHeight="300" />
            <RowDefinition Height="*" MinHeight="0" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Background="{StaticResource CardBrush}"
                BorderBrush="{StaticResource BorderBrushColor}"
                BorderThickness="1"
                Margin="8,8,8,0"
                Padding="12,8">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Left">
                    <TextBlock Text="ENGINEOS / PROJECT HEADER"
                               FontSize="11"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource AccentBrush}" />
                    <TextBlock Text="{Binding RepositoryName, FallbackValue=Engineering Workspace}"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="300"
                               Margin="0,1,0,0" />
                </StackPanel>
                <StackPanel DockPanel.Dock="Right"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <TextBlock Text="{Binding RepositoryPath}"
                               Foreground="{StaticResource SecondaryTextBrush}"
                               TextTrimming="CharacterEllipsis"
                               MaxWidth="280"
                               VerticalAlignment="Center"
                               Margin="16,0,12,0" />
                    <TextBlock Text="{Binding EngineeringState.CurrentReadiness}"
                               Foreground="{StaticResource PrimaryTextBrush}"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center" />
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1" Margin="8,8,8,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="2.2*" MinWidth="420" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="1*" MinWidth="300" />
            </Grid.ColumnDefinitions>

            <Border x:Name="PART_Conversation"
                    Grid.Column="0"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource AccentBrush}"
                    BorderThickness="1"
                    Padding="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,8">
                        <StackPanel DockPanel.Dock="Left">
                            <TextBlock Text="CONVERSATION"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource AccentBrush}" />
                            <TextBlock Text="Ask EngineOS about the project, current work, rounds, handoffs, and recorded evidence."
                                       Foreground="{StaticResource PrimaryTextBrush}"
                                       TextWrapping="Wrap"
                                       Margin="0,2,0,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding Conversation.StatusText}"
                                   DockPanel.Dock="Right"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="12,0,0,0" />
                    </DockPanel>

                    <ScrollViewer Grid.Row="1"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  PanningMode="VerticalOnly">
                        <ItemsControl ItemsSource="{Binding Conversation.Messages}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Style="{StaticResource ConversationMessageBorder}"
                                            CornerRadius="4"
                                            Padding="10"
                                            Margin="0,3">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <DockPanel Grid.Row="0">
                                                <TextBlock Text="{Binding Speaker}"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}" />
                                                <TextBlock Text="{Binding TimestampUtc, StringFormat=HH:mm}"
                                                           Margin="8,0,0,0"
                                                           Foreground="{StaticResource SecondaryTextBrush}" />
                                            </DockPanel>
                                            <TextBlock Grid.Row="1"
                                                       Text="{Binding Text}"
                                                       TextWrapping="Wrap"
                                                       Foreground="{StaticResource PrimaryTextBrush}"
                                                       FontSize="14"
                                                       LineHeight="20"
                                                       Margin="0,5,0,0" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <Grid Grid.Row="2" Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ProgressBar Grid.Column="0"
                                     Width="90"
                                     Height="4"
                                     VerticalAlignment="Center"
                                     IsIndeterminate="True"
                                     Visibility="{Binding Conversation.IsBusy, Converter={StaticResource ConversationBusyVisibility}}" />
                        <TextBlock Grid.Column="1"
                                   Text="{Binding Conversation.StatusText}"
                                   Margin="8,0,0,0"
                                   Foreground="{StaticResource PrimaryTextBrush}"
                                   VerticalAlignment="Center" />
                    </Grid>

                    <Border Grid.Row="3"
                            Background="{StaticResource BackgroundBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            BorderThickness="1"
                            Padding="8"
                            Margin="0,8,0,0"
                            Visibility="{Binding Conversation.HasPendingConfirmation, Converter={StaticResource PendingConfirmationVisibility}}">
                        <DockPanel>
                            <Button Content="Confirm"
                                    Command="{Binding Conversation.ConfirmActionCommand}"
                                    DockPanel.Dock="Right"
                                    Style="{StaticResource AccentButton}"
                                    Padding="14,5"
                                    ToolTip="Confirm and run only this requested Build or Test operation. Output, Problems, and Results will show the evidence." />
                            <StackPanel Margin="0,0,8,0">
                                <TextBlock Text="{Binding Conversation.ConfirmationText}"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource PrimaryTextBrush}"
                                           TextWrapping="Wrap" />
                                <TextBlock Text="Explicit confirmation is required. Only the requested Build or Test operation will run; Output, Problems, and Results will show the evidence."
                                           Foreground="{StaticResource SecondaryTextBrush}"
                                           TextWrapping="Wrap"
                                           Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>

                    <DockPanel Grid.Row="4" Margin="0,8,0,0">
                        <Button Content="Send"
                                Command="{Binding Conversation.SendCommand}"
                                DockPanel.Dock="Right"
                                Style="{StaticResource AccentButton}"
                                Padding="16,7"
                                MinWidth="72"
                                ToolTip="Ask EngineOS about the loaded project" />
                        <TextBox Text="{Binding Conversation.Draft, UpdateSourceTrigger=PropertyChanged}"
                                 AcceptsReturn="True"
                                 TextWrapping="Wrap"
                                 MinHeight="52"
                                 MaxHeight="96"
                                 VerticalScrollBarVisibility="Auto"
                                 Margin="0,0,8,0"
                                 Padding="9"
                                 FontSize="14"
                                 Foreground="{StaticResource PrimaryTextBrush}"
                                 Background="{StaticResource BackgroundBrush}"
                                 BorderBrush="{StaticResource AccentBrush}"
                                 ToolTip="Ask a question about the loaded project, current work, or recorded evidence" />
                    </DockPanel>
                </Grid>
            </Border>

            <GridSplitter Grid.Column="1"
                          Width="8"
                          HorizontalAlignment="Stretch"
                          Background="{StaticResource BorderBrushColor}" />

            <views:EngineeringSteeringPanel Grid.Column="2"
                                            DataContext="{Binding DevelopmentSurface.Steering}" />
        </Grid>

        <views:DevelopmentSurface Grid.Row="2" DataContext="{Binding DevelopmentSurface}" />
    </Grid>
</UserControl>
