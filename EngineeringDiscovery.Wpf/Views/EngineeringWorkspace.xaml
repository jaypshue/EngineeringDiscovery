<UserControl x:Class="EngineeringDiscovery.Wpf.Views.EngineeringWorkspace"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <!-- Engineering Workspace layout (EP-3)
         Regions:
           - Conversation (primary)
           - Context (summary panel)
           - Evidence (placeholder panel)
         The control intentionally contains no engineering logic; it only presents areas where
         the Engineering Partner's conversation and working memory will be surfaced.
    -->

    <Grid Background="White">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="360" />
        </Grid.ColumnDefinitions>

        <!-- Conversation (primary) -->
        <Border Grid.Column="0" Padding="16" Background="#FFF6F8FA" BorderBrush="#FFE6E9EE" BorderThickness="0,0,1,0">
            <StackPanel>
                <TextBlock Text="Conversation" FontSize="20" FontWeight="Bold" Margin="0,0,0,12" />
                <Border x:Name="PART_Conversation" Background="White" CornerRadius="4" Padding="12" BorderBrush="#FFDDDFE3" BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <!-- conversation history grows -->
                            <RowDefinition Height="*" />
                            <!-- fixed input area -->
                            <RowDefinition Height="56" />
                        </Grid.RowDefinitions>

                        <!-- Conversation history: professional transcript style -->
                        <ScrollViewer Grid.Row="0" x:Name="ConversationScroll" VerticalScrollBarVisibility="Auto" Padding="4">
                        <ItemsControl x:Name="ConversationItems" ItemsSource="{Binding Messages}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,6,0,6">
                                            <TextBlock Text="{Binding Speaker}" FontWeight="SemiBold" Foreground="#FF1F2937" />
                                            <TextBlock Text="{Binding Text}" TextWrapping="Wrap" Foreground="#FF111827" Margin="0,2,0,0" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <!-- Fixed input area docked to bottom -->
                        <Border Grid.Row="1" Background="#FFF" Padding="10" BorderThickness="0,1,0,0" BorderBrush="#FFE6E9EE">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="100" />
                                </Grid.ColumnDefinitions>

                                <TextBox x:Name="InputBox" Grid.Column="0" Height="36" VerticalContentAlignment="Center" AcceptsReturn="False" TextWrapping="NoWrap" HorizontalAlignment="Stretch"
                                         Text="{Binding Draft, UpdateSourceTrigger=PropertyChanged, Mode=TwoWay}" />
                                <Button x:Name="SendButton" Grid.Column="1" Content="Send" Width="80" Height="36" Margin="12,0,0,0" HorizontalAlignment="Left"
                                        Command="{Binding SendCommand}" />
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </StackPanel>
        </Border>

        <!-- Right rail: Context and Evidence -->
        <StackPanel Grid.Column="1" Margin="0" Background="#FFF9FAFB" Orientation="Vertical">
            <!-- Context panel -->
            <GroupBox Header="Context" Margin="0,0,0,12">
                <StackPanel x:Name="PART_Context" Margin="4">
                    <TextBlock Text="Current Investigation: (none)" />
                    <TextBlock Text="Current Understanding: (not available)" Margin="0,6,0,0" />
                    <TextBlock Text="Working Memory: summary placeholder" Margin="0,6,0,0" />
                </StackPanel>
            </GroupBox>

            <!-- Evidence panel -->
            <GroupBox Header="Evidence">
                <StackPanel x:Name="PART_Evidence" Margin="4">
                    <TextBlock Text="Repository" FontWeight="Bold" />
                    <TextBlock Text="Screenshots" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="Logs" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="Files" FontWeight="Bold" Margin="0,6,0,0" />
                    <TextBlock Text="(Evidence sources will be added incrementally)" Margin="0,12,0,0" FontStyle="Italic" />
                </StackPanel>
            </GroupBox>
        </StackPanel>
    </Grid>

</UserControl>
