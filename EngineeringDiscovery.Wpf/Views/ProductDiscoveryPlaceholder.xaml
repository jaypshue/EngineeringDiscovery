<UserControl x:Class="EngineeringDiscovery.Wpf.Views.ProductDiscoveryPlaceholder"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             Height="400" Width="600">
    <Grid Background="Transparent" Margin="24">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="720">
            <TextBlock Text="Free Range Engineering" FontSize="28" FontWeight="Bold" Foreground="White" TextAlignment="Center" />
            <TextBlock Text="Build software the same way you would if you had an experienced technical lead." Margin="0,8,0,18" Foreground="#FFB0C4DE" TextAlignment="Center" />

            <TextBlock Text="Begin Product Discovery" FontSize="16" FontWeight="SemiBold" Margin="0,12,0,8" />

            <TextBlock Text="What would you like to build?" FontWeight="Bold" Margin="0,6,0,6" />
            <TextBox x:Name="IdeaText" AcceptsReturn="True" Height="160" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button x:Name="ContinueButton" Content="Continue →" Width="140" Height="38" Click="ContinueButton_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</UserControl>
